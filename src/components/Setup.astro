---
import "../styles/setup.css";
---

<section class="setup" id="setup">

    <div class="container">

        <span class="section-title">
            MEU SETUP
        </span>

        <h2>
            Os equipamentos que utilizo nas lives
        </h2>

        <p class="setup-description">
            Todo o conteúdo da JorgeraTV é produzido utilizando equipamentos
            cuidadosamente escolhidos para oferecer excelente qualidade de
            imagem, áudio e desempenho.
        </p>

        <div class="setup-grid">

            <article class="setup-card">

                <span class="emoji">💻</span>

                <h3>Dell G15</h3>

                <p>
                    Notebook Gamer
                </p>

            </article>

            <article class="setup-card">

                <span class="emoji">🖥️</span>

                <h3>Samsung Odyssey G5</h3>

                <p>
                    Monitor Gamer
                </p>

            </article>

            <article class="setup-card">

                <span class="emoji">🎥</span>

                <h3>Elgato 4K X</h3>

                <p>
                    Placa de Captura
                </p>

            </article>

            <article class="setup-card">

                <span class="emoji">📷</span>

                <h3>Facecam MK.2</h3>

                <p>
                    Webcam Principal
                </p>

            </article>

            <article class="setup-card">

                <span class="emoji">🎙️</span>

                <h3>Hollyland Lark M2</h3>

                <p>
                    Microfone Sem Fio
                </p>

            </article>

            <article class="setup-card">

                <span class="emoji">🎧</span>

                <h3>HIFIMAN Ananda</h3>

                <p>
                    Headphone Hi-Fi
                </p>

            </article>

            <article class="setup-card">

                <span class="emoji">🎛️</span>

                <h3>FiiO K7</h3>

                <p>
                    DAC / Amplificador
                </p>

            </article>

            <article class="setup-card">

                <span class="emoji">🎮</span>

                <h3>PlayStation 5 Slim</h3>

                <p>
                    Console Principal
                </p>

            </article>

            <article class="setup-card">

                <span class="emoji">⌨️</span>

                <h3>Machenike KT68</h3>

                <p>
                    Teclado Mecânico
                </p>

            </article>

            <article class="setup-card">

                <span class="emoji">🖱️</span>

                <h3>Logitech G502 Hero</h3>

                <p>
                    Mouse Gamer
                </p>

            </article>

            <article class="setup-card">

                <span class="emoji">🎚️</span>

                <h3>Stream Deck MK2</h3>

                <p>
                    Controle de Lives
                </p>

            </article>

            <article class="setup-card">

                <span class="emoji">💡</span>

                <h3>Govee RGBIC</h3>

                <p>
                    Iluminação do Estúdio
                </p>

            </article>

        </div>

    </div>

</section>
---

<section class="setup-page">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="setup-hero">

        <div class="setup-hero__glow setup-hero__glow--one"></div>
        <div class="setup-hero__glow setup-hero__glow--two"></div>

        <div class="setup-hero__inner">

            <div class="setup-eyebrow">
                <span>🎮</span>
                O SETUP DA JORGERATV
            </div>

            <h1>
                Onde a ideia
                <span>vira jogo.</span>
            </h1>

            <p>
                Não é apenas uma coleção de equipamentos.
                É o espaço onde eu jogo, gravo, transmito,
                testo tecnologia e transformo horas de diversão
                em experiências para compartilhar.
            </p>

            <div class="setup-hero__stats">

                <div>
                    <strong>21</strong>
                    <span>equipamentos</span>
                </div>

                <div>
                    <strong>6</strong>
                    <span>categorias</span>
                </div>

                <div>
                    <strong>1</strong>
                    <span>paixão</span>
                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CATEGORIAS
    ====================================================== -->

    <div class="setup-content">

        {categories.map((category, categoryIndex) => (

            <section
                class:list={[
                    "setup-category",
                    category.alternate && "setup-category--alt"
                ]}
            >

                <div class="setup-category__heading">

                    <span class="setup-section-number">
                        {String(categoryIndex + 1).padStart(2, "0")}
                    </span>

                    <div>

                        <span class="setup-eyebrow">
                            {category.eyebrow}
                        </span>

                        <h2>
                            {category.title}
                        </h2>

                        <p>
                            {category.description}
                        </p>

                    </div>

                </div>


                <div class="setup-grid">

                    {category.products.map((product) => (

                        <a
                            class="setup-card"
                            href={product.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`${product.name} — ${product.linkLabel ?? "Ver fabricante"}`}
                        >

                            <div class="setup-card__image">

                                <img
                                    src={product.image.src}
                                    alt={`${product.brand} ${product.name}`}
                                    loading="lazy"
                                    decoding="async"
                                />

                                <span class="setup-card__external">
                                    ↗
                                </span>

                                {product.units && (
                                    <span class="setup-card__units">
                                        {product.units}
                                    </span>
                                )}

                            </div>


                            <div class="setup-card__body">

                                <span class="setup-card__brand">
                                    {product.brand}
                                </span>

                                <h3>
                                    {product.name}
                                </h3>

                                <p>
                                    {product.description}
                                </p>

                                <div class="setup-card__tags">

                                    {product.tags.map((tag) => (
                                        <span>{tag}</span>
                                    ))}

                                </div>

                            </div>


                            <div class="setup-card__footer">

                                <span>
                                    Equipamento do setup
                                </span>

                                <strong>
                                    {product.linkLabel ?? "Ver fabricante"} →
                                </strong>

                            </div>

                        </a>

                    ))}

                </div>

            </section>

        ))}


        <!-- =================================================
             ENCERRAMENTO
        ================================================== -->

        <section class="setup-ending">

            <div class="setup-ending__scanline"></div>

            <span class="setup-eyebrow">
                AGORA VOCÊ CONHECE A MÁQUINA
            </span>

            <h2>
                O equipamento muda.
                <span>A vontade de jogar continua.</span>
            </h2>

            <p>
                Cada peça desse setup tem uma função.
                Mas nenhuma delas explica sozinha o motivo
                de tudo isso existir.
            </p>

            <p class="setup-ending__strong">
                No fim das contas, o melhor equipamento
                continua sendo aquele que ajuda a gente
                a se divertir.
            </p>

            <a
                href="/"
                class="setup-ending__button"
            >
                🎮 VOLTAR PARA A JORGERATV
            </a>

        </section>

    </div>

</section>

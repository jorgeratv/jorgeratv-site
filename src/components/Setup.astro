---

<section class="setup-page">

    <!-- HERO -->

    <header class="setup-hero">

        <div class="setup-hero__inner">

            <span class="setup-eyebrow">
                🎮 O SETUP DA JORGERATV
            </span>

            <h1>
                A tecnologia
                <span>por trás da tela.</span>
            </h1>

            <p>
                Cada equipamento tem uma função.
                Cada escolha faz parte da experiência.
                Aqui está a estrutura que transforma
                gameplay em conteúdo.
            </p>

            <div class="setup-hero__stats">

                <div>
                    <strong>21</strong>
                    <span>equipamentos</span>
                </div>

                <div>
                    <strong>08</strong>
                    <span>categorias</span>
                </div>

                <div>
                    <strong>01</strong>
                    <span>setup</span>
                </div>

            </div>

        </div>

    </header>


    <!-- CATEGORIAS -->

    <div class="setup-content">

        {categories.map((category, categoryIndex) => (

            <section
                class:list={[
                    "setup-category",
                    categoryIndex % 2 === 1 && "setup-category--alt"
                ]}
                id={category.id}
            >

                <div class="setup-category__heading">

                    <span class="setup-eyebrow">
                        {category.eyebrow}
                    </span>

                    <h2>
                        {category.title}
                    </h2>

                    <p>
                        {category.description}
                    </p>

                </div>


                <div class="setup-grid">

                    {category.items.map((item) => (

                        <a
                            class="setup-card"
                            href={item.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`Conhecer ${item.name}`}
                        >

                            <!-- FOTO -->

                            <div class="setup-card__image">

                                <img
                                    src={item.image}
                                    alt={item.name}
                                    loading="lazy"
                                />

                                <span class="setup-card__external">
                                    ↗
                                </span>

                            </div>


                            <!-- CONTEÚDO -->

                            <div class="setup-card__body">

                                <span class="setup-card__model">
                                    {item.model}
                                </span>

                                <h3>
                                    {item.name}
                                </h3>

                                <p>
                                    {item.description}
                                </p>

                                <div class="setup-card__tags">

                                    {item.tags.map((tag) => (
                                        <span>
                                            {tag}
                                        </span>
                                    ))}

                                </div>

                            </div>


                            <!-- FOOTER -->

                            <div class="setup-card__footer">

                                <span>
                                    Fabricante / produto
                                </span>

                                <strong>
                                    Conhecer →
                                </strong>

                            </div>

                        </a>

                    ))}

                </div>

            </section>

        ))}


        <!-- FECHAMENTO -->

        <section class="setup-ending">

            <span class="setup-eyebrow">
                MAIS DO QUE EQUIPAMENTOS
            </span>

            <h2>
                O setup muda.
                <span>A vontade de jogar continua.</span>
            </h2>

            <p>
                Hardware pode mudar.
                Consoles podem mudar.
                Tecnologias novas vão aparecer.
                Mas o motivo de tudo isso continua sendo o mesmo:
                jogar, criar, conversar e compartilhar.
            </p>

            <a
                href="/sobre"
                class="setup-ending__button"
            >
                ← Conheça minha história
            </a>

        </section>

    </div>

</section>

interface Product {
    image: ImageMetadata;
    brand: string;
    name: string;
    description: string;
    tags: string[];
    link: string;
    units?: string;
    linkLabel?: string;
}

interface Category {
    eyebrow: string;
    title: string;
    description: string;
    products: Product[];
    alternate?: boolean;
}


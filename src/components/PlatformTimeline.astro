<style>
  /* =========================================================
     BASE
  ========================================================== */

  .jorgera-timeline {
    position: relative;
    width: 100%;
    box-sizing: border-box;

    /*
     * IMPORTANTE:
     * O Header do site é fixo.
     * Este espaço impede que ele fique por cima
     * do início da timeline.
     */
    padding-top: 120px;
    padding-bottom: 120px;

    background:
      radial-gradient(
        circle at 50% 15%,
        rgba(120, 0, 15, 0.12),
        transparent 38%
      ),
      #050505;

    color: #f5f1eb;
  }


  /* =========================================================
     ERAS
  ========================================================== */

  .timeline-era {
    width: min(1120px, calc(100% - 80px));
    margin: 0 auto;
    padding: 110px 0;
  }


  .timeline-era + .timeline-era {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }


  /* =========================================================
     CABEÇALHO DA ERA
  ========================================================== */

  .era-header {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 45px;
    align-items: start;

    margin-bottom: 65px;
  }


  .era-number {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 58px;
    height: 58px;

    border: 1px solid rgba(255, 40, 50, 0.55);
    border-radius: 50%;

    color: #ff3038;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }


  .era-label {
    display: block;

    margin-bottom: 15px;

    color: #ff3038;

    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }


  .era-heading h2 {
    margin: 0 0 20px;

    max-width: 900px;

    color: #f5f1eb;

    font-size: clamp(48px, 6vw, 82px);
    line-height: 0.98;
    font-weight: 900;
    letter-spacing: -0.055em;
  }


  .era-heading p {
    max-width: 800px;

    margin: 0;

    color: #9f9995;

    font-size: 18px;
    line-height: 1.75;
  }


  /* =========================================================
     GRID
  ========================================================== */

  .platform-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }


  /* =========================================================
     CARD
  ========================================================== */

  .platform-card {
    position: relative;

    min-height: 300px;

    padding: 34px 32px;

    box-sizing: border-box;

    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 18px;

    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,0.025),
        rgba(255,255,255,0.008)
      );

    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease;
  }


  .platform-card:hover {
    transform: translateY(-4px);

    border-color: rgba(255, 45, 55, 0.28);

    background:
      linear-gradient(
        145deg,
        rgba(255, 40, 50, 0.055),
        rgba(255,255,255,0.01)
      );
  }


  .platform-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    margin-bottom: 28px;
  }


  .platform-year {
    color: #ff3038;

    font-size: 15px;
    font-weight: 900;
    letter-spacing: 0.08em;
  }


  .platform-type {
    padding: 7px 10px;

    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 6px;

    color: #8d8885;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;

    white-space: nowrap;
  }


  .platform-card h3 {
    margin: 0 0 18px;

    color: #f5f1eb;

    font-size: 28px;
    line-height: 1.1;
    font-weight: 900;

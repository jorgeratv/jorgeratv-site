    year: "2001",
    title: "PC ATHLON XP + WINDOWS XP",
    type: "LAN houses",
    description:
      "Foi nessa época que conheci Half-Life e seus mods e comecei a frequentar LAN houses. Foi uma fase que ajudou a definir minha relação com o PC e com os jogos multiplayer.",
    games: [
      "Half-Life",
      "Team Fortress",
      "Counter-Strike 1.5",
      "Counter-Strike 1.6",
      "Quake III Arena",
      "Call of Duty",
      "Max Payne",
      "Age of Mythology"
    ]
  },

  {
    year: "2002",
    title: "PLAYSTATION 2",
    type: "Uma geração inesquecível",
    description:
      "Uma das gerações mais marcantes para quem cresceu jogando. O PlayStation 2 trouxe mundos enormes, grandes histórias e alguns dos jogos que mais ficaram na memória.",
    games: [
      "Black",
      "Need for Speed Underground 2",
      "GTA: San Andreas",
      "GTA: Vice City",
      "God of War II",
      "Resident Evil 4",
      "Metal Gear Solid 3"
    ]
  },

  {
    year: "2006",
    title: "XBOX 360",
    type: "Nova geração",
    description:
      "Uma geração que trouxe grandes experiências de ação, corrida e multiplayer e consolidou uma nova era dos videogames.",
    games: [
      "Gears of War",
      "Halo 3",
      "Forza Motorsport 4",
      "Batman: Arkham City",
      "Red Dead Redemption",
      "Call of Duty: Modern Warfare"
    ]
  },

  {
    year: "2008",
    title: "PLAYSTATION 3",
    type: "Alta definição",
    description:
      "Uma geração marcada por grandes histórias, mundos abertos e experiências cinematográficas que elevaram ainda mais o nível dos videogames.",
    games: [
      "The Last of Us",
      "God of War III",
      "Grand Theft Auto V",
      "Assassin's Creed III",
      "Killzone 3",
      "Battlefield 4",
      "Far Cry 3",
      "Ultimate Marvel vs. Capcom 3"
    ]
  },

  {
    year: "2009",
    title: "PC AMD PHENOM II X4 + WINDOWS 7",

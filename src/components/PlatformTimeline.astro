      "Super Mario Bros.",
      "Contra",
      "DuckTales",
      "Mega Man 2",
      "Castlevania",
      "Battletoads"
    ]
  },

  {
    year: "1993",
    title: "MEGA DRIVE",
    type: "Primeiros contatos",
    contact:
      "Conheci jogando com meus primos.",
    description:
      "Assim como o Master System, não tive um Mega Drive. Meus primos tinham e eu aproveitava cada oportunidade para jogar.",
    games: [
      "Altered Beast",
      "Streets of Rage",
      "Ghouls 'n Ghosts",
      "Earthworm Jim"
    ]
  },

  {
    year: "1994",
    title: "SUPER NINTENDO",
    type: "Uma geração inesquecível",
    description:
      "Uma das fases mais marcantes da minha vida gamer. O Super Nintendo abriu um universo enorme de aventuras, lutas, RPGs, corridas e exploração.",

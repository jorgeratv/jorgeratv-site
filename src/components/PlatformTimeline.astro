---
/*
   ===========================================
   PLATFORM TIMELINE - JORGERATV
   Minha jornada pelos videogames
   ===========================================
*/

const generations = [
  {
    number: "01",
    era: "GERAÇÃO 8-BIT",
    title: "Onde tudo começou.",
    description:
      "Os primeiros contatos com os videogames. Uma época de descobertas, diversão simples e clássicos que ajudaram a construir a minha paixão pelos games.",
    platforms: [
      {
        year: "1990",
        name: "ATARI 2600",
        description:
          "Foi aqui que tudo começou. Meu primeiro contato com videogames e a primeira porta para um universo que nunca mais deixou de fazer parte da minha vida.",
        games: [
          "Pitfall",
          "River Raid",
          "Enduro",
          "Frogger",
          "Pac-Man",
          "Adventure",
          "H.E.R.O."
        ]
      },
      {
        year: "1993",
        name: "MASTER SYSTEM",
        contact: "Conheci jogando com amigos.",
        description:
          "Eu não tinha um Master System, mas meus amigos tinham. Foi através deles que conheci alguns dos grandes clássicos da Sega.",
        games: [
          "Alex Kidd",
          "Sonic",
          "Shinobi",
          "Golden Axe",
          "Double Dragon"
        ]
      },
      {
        year: "1993",
        name: "NES",
        description:
          "O Nintendo 8-bit marcou uma nova fase da minha infância e trouxe alguns dos personagens e franquias que continuam comigo até hoje.",
        games: [
          "Super Mario Bros.",
          "Contra",
          "DuckTales",
          "Mega Man 2",
          "Castlevania",
          "Battletoads"
        ]
      }
    ]
  },

  {
    number: "02",
    era: "GERAÇÃO 16-BIT",
    title: "A era dos grandes clássicos.",
    description:
      "Os videogames ficaram maiores, mais coloridos e muito mais ambiciosos. Foi uma das épocas mais marcantes da minha infância.",
    platforms: [
      {
        year: "1993",
        name: "MEGA DRIVE",
        contact: "Conheci jogando com meus primos.",
        description:
          "Assim como o Master System, não tive um Mega Drive. Meus primos tinham e eu aproveitava cada oportunidade para jogar.",
        games: [
          "Altered Beast",
          "Streets of Rage",
          "Ghouls 'n Ghosts",
          "Earthworm Jim"
        ]
      },
      {
        year: "1994",
        name: "SUPER NINTENDO",
        description:
          "Uma das fases mais marcantes da minha vida gamer. O Super Nintendo abriu um universo enorme de aventuras, lutas, RPGs, corridas e exploração.",
        games: [
          "Donkey Kong",
          "Super Mario World",
          "Mortal Kombat",
          "Street Fighter",
          "Chrono Trigger",
          "Final Fantasy",
          "Contra III",
          "Top Gear",
          "International Superstar Soccer Deluxe",
          "Final Fight",
          "Sunset Riders",
          "Aladdin",
          "Legend of Mana",
          "Super Metroid",
          "Demon's Crest"
        ]
      }
    ]
  },

  {
    number: "03",
    era: "GERAÇÃO 32-BIT / 64-BIT",
    title: "Quando os mundos começaram a ganhar outra dimensão.",
    description:
      "Computadores mais poderosos, novas tecnologias e videogames que começaram a aproximar cada vez mais os jogos daquilo que eu imaginava.",
    platforms: [
      {
        year: "1994",
        name: "PC 486 + WINDOWS 3.1",
        contact: "Conheci através do computador do meu pai.",
        description:
          "Meu pai tinha o computador, mas deixava eu brincar. Foi quando videogames e tecnologia começaram a andar juntos na minha cabeça.",
        games: [
          "DOOM",
          "Wolfenstein",
          "Duke Nukem",
          "Hexen",
          "Blood",
          "Prince of Persia",
          "Stunts",
          "Monkey Island",
          "Full Throttle"
        ]
      },
      {
        year: "1995",
        name: "3DO",
        contact: "Conheci jogando em uma locadora.",
        description:
          "Não tive um 3DO, mas conheci a plataforma em uma locadora. Eu pagava por hora e aproveitava cada minuto para descobrir aquela tecnologia diferente.",
        games: [
          "Road Rash",
          "The Need for Speed",
          "DOOM",
          "Super Street Fighter II Turbo"
        ]
      },
      {
        year: "1995",
        name: "NEO GEO CD",
        contact: "Conheci jogando em uma locadora.",
        description:
          "Outra experiência de locadora que ficou marcada. O Neo Geo era praticamente um sonho para quem gostava dos arcades.",
        games: [
          "The King of Fighters '95",
          "The King of Fighters '96",
          "Metal Slug",
          "Samurai Shodown III",
          "Fatal Fury Special",
          "Super Sidekicks 3"
        ]
      },
      {
        year: "1997",
        name: "NINTENDO 64",
        description:
          "O Nintendo 64 foi uma verdadeira revolução. Foi uma das primeiras vezes em que senti que os mundos dos videogames estavam realmente ganhando outra dimensão.",
        games: [
          "Super Mario 64",
          "Mario Kart 64",
          "Banjo-Kazooie",
          "GoldenEye 007",
          "Donkey Kong 64",
          "Star Fox 64",
          "1080 Snowboarding",
          "Wave Race 64"
        ]
      },
      {
        year: "1997",
        name: "PC PENTIUM II + WINDOWS 95",
        description:
          "Meu primeiro computador exclusivamente meu. A partir daqui, o PC passou a ocupar um espaço cada vez maior na minha vida.",
        games: [
          "DOOM II",
          "Quake II",
          "Carmageddon",
          "Diablo",
          "Heroes of Might and Magic III",
          "Age of Empires",
          "Command & Conquer: Red Alert"
        ]
      },
      {
        year: "1998",
        name: "PLAYSTATION 1",
        description:
          "O PlayStation marcou uma nova era para mim. Foi quando os jogos começaram a entregar experiências cinematográficas e personagens que ficaram para sempre na memória.",
        games: [
          "Resident Evil 1",
          "Resident Evil 2",
          "Resident Evil 3",
          "Dino Crisis",
          "Medal of Honor",
          "Gran Turismo 2",
          "Castlevania: Symphony of the Night",
          "Metal Gear Solid",
          "Tekken 3"
        ]
      }
    ]
  },

  {
    number: "04",
    era: "NOVA GERAÇÃO",
    title: "Os videogames ficaram gigantes.",
    description:
      "A chegada de novas gerações trouxe mundos maiores, experiências online, gráficos impressionantes e algumas das maiores franquias da minha história gamer.",
    platforms: [
      {
        year: "2001",
        name: "PC ATHLON XP + WINDOWS XP",
        description:
          "Foi aqui que conheci Half-Life e seus mods. Também foi a época em que comecei a frequentar LAN houses e descobri uma nova forma de jogar com outras pessoas.",
        games: [
          "Half-Life",
          "Team Fortress",
          "Counter-Strike 1.5",
          "Counter-Strike 1.6",
          "Quake III",
          "Call of Duty",
          "Max Payne",
          "Age of Mythology"
        ]
      },
      {
        year: "2002",
        name: "PLAYSTATION 2",
        description:
          "Uma das plataformas mais importantes da minha vida gamer. O PS2 trouxe uma quantidade absurda de jogos marcantes e experiências que ficaram na memória.",
        games: [
          "BLACK",
          "Need for Speed Underground 2",
          "GTA San Andreas",
          "GTA Vice City",
          "God of War II",
          "Resident Evil 4",
          "Metal Gear Solid 3"
        ]
      },
      {
        year: "2006",
        name: "XBOX 360",
        description:
          "Uma nova geração chegou trazendo alta definição, multiplayer online e experiências que mostravam o potencial dos videogames modernos.",
        games: [
          "Gears of War",
          "Halo 3",
          "Forza Motorsport 4",
          "Batman: Arkham City",
          "Red Dead Redemption",
          "Call of Duty: Modern Warfare"
        ]
      },
      {
        year: "2008",
        name: "PLAYSTATION 3",
        description:
          "Uma geração marcada por grandes aventuras, experiências cinematográficas e jogos que elevaram ainda mais o padrão dos consoles.",
        games: [
          "The Last of Us",
          "God of War III",
          "Grand Theft Auto V",
          "Assassin's Creed III",
          "Killzone 3",
          "Battlefield 4",
          "Far Cry 3",
          "Ultimate Marvel vs. Capcom 3"
        ]
      }
    ]
  },

  {
    number: "05",
    era: "GERAÇÃO HD",
    title: "Um mundo cada vez maior.",
    description:
      "Os jogos passaram a entregar mundos abertos gigantescos, gráficos impressionantes e experiências cada vez mais próximas do cinema.",
    platforms: [
      {
        year: "2009",
        name: "PC AMD PHENOM II X4 + WINDOWS 7",
        description:
          "Uma nova fase do PC gamer. Mais potência, jogos mais ambiciosos e uma evolução enorme na qualidade visual das experiências.",
        games: [
          "Call of Duty: Modern Warfare 2",
          "Left 4 Dead 2",
          "Fallout 3",
          "GTA IV",
          "Age of Empires III",
          "Crysis",
          "The Elder Scrolls V: Skyrim"
        ]
      },
      {
        year: "2013",
        name: "PLAYSTATION 4",
        description:
          "O PlayStation 4 trouxe alguns dos jogos que mais marcaram a minha trajetória recente, com mundos abertos enormes e experiências cinematográficas.",
        games: [
          "Red Dead Redemption 2",
          "Grand Theft Auto V",
          "The Last of Us Part II",
          "God of War",
          "Resident Evil 7",
          "Mortal Kombat X",
          "The Witcher 3",
          "Uncharted 4",
          "Ace Combat 7"
        ]
      },
      {
        year: "2020",
        name: "XBOX SERIES S",
        description:
          "Uma porta de entrada para uma nova geração, trazendo velocidade, retrocompatibilidade e experiências modernas em um formato compacto.",
        games: [
          "Gears 5",
          "DOOM Eternal",
          "Halo Infinite",
          "Forza Horizon 5",
          "Far Cry 5"
        ]
      }
    ]
  },

  {
    number: "06",
    era: "GERAÇÃO ATUAL",
    title: "A história continua.",
    description:
      "Hoje, a tecnologia chegou a um nível que parecia impossível quando eu comecei. Mas a essência continua a mesma: jogar, descobrir mundos e viver novas histórias.",
    platforms: [
      {
        year: "2022",
        name: "PC DELL G15",
        description:
          "Meu PC gamer atual. Uma máquina que reúne trabalho, criação de conteúdo, transmissões e, principalmente, muitos momentos jogando.",
        games: [
          "Battlefield 2042",
          "DOOM: The Dark Ages",
          "Counter-Strike 2",
          "Cyberpunk 2077"
        ]
      },
      {
        year: "2023",
        name: "PLAYSTATION 5 SLIM",
        description:
          "Meu console atual. Uma nova geração de velocidade, gráficos e experiências que continuam expandindo a forma como eu vivo os videogames.",
        games: [
          "God of War Ragnarök",
          "Resident Evil 4 Remake",
          "Battlefield 6",
          "Metal Gear Solid Delta",
          "The Callisto Protocol"
        ]
      },
      {
        year: "2024",
        name: "NINTENDO SWITCH LITE",
        description:
          "Uma experiência diferente das demais plataformas. Portabilidade, Nintendo e alguns dos mundos mais carismáticos dos videogames.",
        games: [
          "Super Mario 3D World + Bowser's Fury",
          "Super Mario Odyssey",
          "Mario Kart 8 Deluxe",
          "Donkey Kong Country: Tropical Freeze",
          "The Legend of Zelda: Tears of the Kingdom"
        ]
      }
    ]
  }
];
---

<section class="platform-timeline" id="plataformas">

  <div class="platform-container">

    <!-- CABEÇALHO -->
    <header class="platform-hero">

      <div class="platform-eyebrow">
        JORGERATV • MINHA HISTÓRIA GAMER
      </div>

      <h1>
        MINHA JORNADA<br />
        PELOS VIDEOGAMES.
      </h1>

      <p>
        Do Atari 2600 ao PlayStation 5 e ao PC gamer.
        Mais de três décadas atravessando gerações,
        tecnologias, amizades e histórias que ficaram para sempre.
      </p>

      <div class="platform-stats">

        <div>
          <strong>21</strong>
          <span>Plataformas</span>
        </div>

        <div>
          <strong>1990</strong>
          <span>Primeiro contato</span>
        </div>

        <div>
          <strong>2024</strong>
          <span>Fase atual</span>
        </div>

      </div>

    </header>


    <!-- GERAÇÕES -->

    <div class="generations">

      {generations.map((generation) => (

        <section class="generation">

          <!-- CABEÇALHO DA GERAÇÃO -->

          <div class="generation-header">

            <div class="generation-number">
              {generation.number}
            </div>

            <div class="generation-heading">

              <span class="generation-label">
                {generation.era}
              </span>

              <h2>
                {generation.title}
              </h2>

              <p>
                {generation.description}
              </p>

            </div>

          </div>


          <!-- PLATAFORMAS -->

          <div class="platform-grid">

            {generation.platforms.map((platform) => (

              <article class="platform-card">

                <div class="platform-card-top">

                  <span class="platform-year">
                    {platform.year}
                  </span>

                  {platform.contact && (
                    <span class="platform-contact">
                      {platform.contact}
                    </span>
                  )}

                </div>


                <h3>
                  {platform.name}
                </h3>


                <p class="platform-description">
                  {platform.description}
                </p>


                <div class="games-area">

                  <span class="games-label">
                    JOGOS QUE MARCARAM ESSA FASE
                  </span>

                  <div class="games-list">

                    {platform.games.map((game) => (
                      <span class="game-tag">
                        {game}
                      </span>
                    ))}

                  </div>

                </div>

              </article>

            ))}

          </div>

        </section>

      ))}

    </div>


    <!-- ENCERRAMENTO -->

    <section class="platform-ending">

      <span>
        E A HISTÓRIA CONTINUA
      </span>

      <h2>
        A próxima geração<br />
        ainda está por vir.
      </h2>

      <p>
        Porque depois de tantos anos, uma coisa não mudou:
        eu continuo descobrindo novos mundos para jogar.
      </p>

    </section>

  </div>

</section>

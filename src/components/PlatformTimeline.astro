      "Donkey Kong",
      "Super Mario World",
      "Mortal Kombat",
      "Street Fighter",
      "Chrono Trigger",
      "Final Fantasy",
      "Contra III",
      "Top Gear",
      "International Superstar Soccer Deluxe",
      "Final Fight",
      "Sunset Riders",
      "Aladdin",
      "Legend of Mana",
      "Super Metroid",
      "Demon's Crest"
    ]
  },

  {
    year: "1994",
    title: "PC 486 + WINDOWS 3.1",
    type: "Tecnologia e descoberta",
    contact:
      "Conheci através do computador do meu pai.",
    description:
      "Meu pai tinha o computador, mas deixava eu brincar. Foi quando videogames e tecnologia começaram a andar juntos na minha cabeça.",
    games: [
      "DOOM",
      "Wolfenstein 3D",
      "Duke Nukem",
      "Hexen",
      "Blood",
      "Prince of Persia",
      "Stunts",
      "Monkey Island",
      "Full Throttle"
    ]
  },

  {
    year: "1995",
    title: "3DO",
    type: "Experiência de locadora",
    contact:
      "Conheci jogando em uma locadora, pagando por hora.",
    description:
      "Não tive um 3DO, mas conheci a plataforma em uma locadora. Eu pagava por hora e aproveitava cada minuto para descobrir aquela tecnologia diferente.",
    games: [
      "Road Rash",
      "The Need for Speed",
      "DOOM",
      "Super Street Fighter II Turbo"
    ]
  },

  {
    year: "1995",
    title: "NEO GEO CD",
    type: "Experiência de locadora",
    contact:
      "Conheci jogando em uma locadora, pagando por hora.",
    description:
      "Outra experiência de locadora que ficou marcada. O Neo Geo era praticamente um sonho para quem gostava dos arcades.",
    games: [
      "The King of Fighters '95",
      "The King of Fighters '96",
      "Metal Slug",
      "Samurai Shodown III",
      "Fatal Fury Special",
      "Super Sidekicks 3"
    ]
  },

  {

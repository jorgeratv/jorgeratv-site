<section class="jorgera-timeline" id="historia-gamer">

  <!-- =========================================================
       ERA 01 — 8 BITS
  ========================================================== -->

  <section class="timeline-era">

    <div class="era-header">
      <span class="era-number">01</span>

      <div class="era-heading">
        <span class="era-label">ERA 01</span>

        <h2>OS PRIMEIROS PIXELS</h2>

        <p>
          Foi aqui que tudo começou. Os primeiros videogames, os primeiros
          controles e as primeiras lembranças que ajudaram a construir
          minha relação com os jogos.
        </p>
      </div>
    </div>


    <div class="platform-grid">

      <!-- ATARI 2600 -->

      <article class="platform-card">

        <div class="platform-top">
          <span class="platform-year">1990</span>
          <span class="platform-type">CONSOLE • 8-BIT</span>
        </div>

        <h3>ATARI 2600</h3>

        <p class="platform-description">
          Foi aqui que tudo começou. Meu primeiro contato com videogames
          e a primeira porta para um universo que nunca mais deixou
          de fazer parte da minha vida.
        </p>

        <div class="games">
          <span class="games-title">JOGOS QUE MARCARAM ESSA FASE</span>

          <div class="game-list">
            <span>Pitfall!</span>
            <span>River Raid</span>
            <span>Enduro</span>
            <span>Frogger</span>
            <span>Pac-Man</span>
            <span>Adventure</span>
            <span>H.E.R.O.</span>
          </div>
        </div>

      </article>


      <!-- MASTER SYSTEM -->

      <article class="platform-card">

        <div class="platform-top">
          <span class="platform-year">1993</span>
          <span class="platform-type">CONSOLE • 8-BIT</span>
        </div>

        <h3>MASTER SYSTEM</h3>

        <p class="platform-description">
          Não tive um Master System, mas meus amigos tinham.
          Foi através deles que conheci alguns dos grandes clássicos
          da Sega.
        </p>

        <div class="contact-note">
          EXPERIÊNCIA ATRAVÉS DE AMIGOS
        </div>

        <div class="games">
          <span class="games-title">JOGOS QUE MARCARAM ESSA FASE</span>

          <div class="game-list">
            <span>Alex Kidd</span>
            <span>Sonic</span>
            <span>Shinobi</span>
            <span>Golden Axe</span>
            <span>Double Dragon</span>
          </div>
        </div>

      </article>


      <!-- NES -->

      <article class="platform-card">

        <div class="platform-top">
          <span class="platform-year">1993</span>
          <span class="platform-type">CONSOLE • 8-BIT</span>
        </div>

        <h3>NINTENDO NES</h3>

        <p class="platform-description">
          O Nintendo 8-bit marcou uma nova fase da minha infância
          e trouxe alguns dos personagens e franquias que continuam
          comigo até hoje.
        </p>

        <div class="games">
          <span class="games-title">JOGOS QUE MARCARAM ESSA FASE</span>

          <div class="game-list">
            <span>Super Mario Bros.</span>
            <span>Contra</span>
            <span>DuckTales</span>
            <span>Mega Man 2</span>
            <span>Castlevania</span>
            <span>Battletoads</span>

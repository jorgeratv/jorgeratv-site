---
import "../styles/platform-timeline.css";

const eras = [
    {
        number: "01",
        label: "ERA 01",
        title: "OS PRIMEIROS PIXELS",
        description:
            "Foi aqui que tudo começou. Os primeiros videogames, os primeiros controles e as primeiras lembranças que ajudaram a construir minha relação com os jogos.",
        platforms: [
            {
                year: "1990",
                type: "CONSOLE • 8-BIT",
                name: "ATARI 2600",
                description:
                    "Foi aqui que tudo começou. Meu primeiro contato com videogames e a primeira porta para um universo que nunca mais deixou de fazer parte da minha vida.",
                games: [
                    "Pitfall!",
                    "River Raid",
                    "Enduro",
                    "Frogger",
                    "Pac-Man",
                    "Adventure",
                    "H.E.R.O."
                ]
            },
            {
                year: "1993",
                type: "CONSOLE • 8-BIT",
                name: "MASTER SYSTEM",
                description:
                    "Eu não tinha um Master System, mas meus amigos tinham. Foi através deles que conheci alguns dos grandes clássicos da Sega.",
                games: [
                    "Alex Kidd",
                    "Sonic",
                    "Shinobi",
                    "Golden Axe",
                    "Double Dragon"
                ]
            },
            {
                year: "1993",
                type: "CONSOLE • 8-BIT",
                name: "NES",
                description:
                    "O Nintendo 8-bit marcou uma nova fase da minha infância e trouxe personagens e franquias que continuam comigo até hoje.",
                games: [
                    "Super Mario Bros.",
                    "Contra",
                    "DuckTales",
                    "Mega Man 2",
                    "Castlevania",
                    "Battletoads"
                ]
            }
        ]
    },

    {
        number: "02",
        label: "ERA 02",
        title: "A ERA 16-BIT",
        description:
            "Uma geração que elevou os videogames a outro nível. Gráficos melhores, trilhas memoráveis e alguns dos jogos que mais marcaram minha infância.",
        platforms: [
            {
                year: "1993",
                type: "CONSOLE • 16-BIT",
                name: "MEGA DRIVE",
                description:
                    "Assim como o Master System, não tive um Mega Drive. Meus primos tinham e eu aproveitava cada oportunidade para jogar.",
                games: [
                    "Altered Beast",
                    "Streets of Rage",
                    "Ghouls 'n Ghosts",
                    "Earthworm Jim"
                ]
            },
            {
                year: "1994",
                type: "CONSOLE • 16-BIT",
                name: "SUPER NINTENDO",
                description:
                    "Uma das fases mais marcantes da minha vida gamer. O Super Nintendo abriu um universo enorme de aventuras, lutas, RPGs, corridas e exploração.",
                games: [
                    "Donkey Kong",
                    "Super Mario World",
                    "Mortal Kombat",
                    "Street Fighter",
                    "Chrono Trigger",
                    "Final Fantasy",
                    "Contra III",
                    "Top Gear",
                    "International Superstar Soccer Deluxe",
                    "Final Fight",
                    "Sunset Riders",
                    "Aladdin",
                    "Legend of Mana",
                    "Super Metroid",
                    "Demon's Crest"
                ]
            }
        ]
    },

    {
        number: "03",
        label: "ERA 03",
        title: "A REVOLUÇÃO 3D",
        description:
            "Os videogames começaram a abandonar os sprites e entrar de vez em mundos tridimensionais. Foi uma transformação que mudou para sempre a maneira de jogar.",
        platforms: [
            {
                year: "1995",
                type: "CONSOLE • 32-BIT",
                name: "3DO",
                description:
                    "Não tive um 3DO, mas conheci a plataforma em uma locadora. Eu pagava por hora e aproveitava cada minuto para descobrir aquela tecnologia diferente.",
                games: [
                    "Road Rash",
                    "The Need for Speed",
                    "Alone in the Dark",
                    "Gex",
                    "FIFA International Soccer",
                    "Super Street Fighter II Turbo"
                ]
            },
            {
                year: "1995",
                type: "CONSOLE • CD",
                name: "NEO GEO CD",
                description:
                    "Outra experiência de locadora que ficou marcada. O Neo Geo era praticamente um sonho para quem gostava dos arcades.",
                games: [
                    "The King of Fighters '95",
                    "The King of Fighters '96",
                    "Metal Slug",
                    "Samurai Shodown III",
                    "Fatal Fury Special",
                    "Super Sidekicks 3"
                ]
            },
            {
                year: "1997",
                type: "CONSOLE • 64-BIT",
                name: "NINTENDO 64",
                description:
                    "O Nintendo 64 foi uma verdadeira revolução. Foi uma das primeiras vezes em que senti que os mundos dos videogames estavam realmente ganhando outra dimensão.",
                games: [
                    "Super Mario 64",
                    "Mario Kart 64",
                    "Banjo-Kazooie",
                    "GoldenEye 007",
                    "Donkey Kong 64",
                    "Star Fox 64",
                    "1080 Snowboarding",
                    "Wave Race 64"
                ]
            },
            {
                year: "1998",
                type: "CONSOLE • 32-BIT",
                name: "PLAYSTATION 1",
                description:
                    "O PlayStation marcou uma das grandes viradas da minha vida gamer. Foi uma geração de experiências que ajudaram a definir o videogame moderno.",
                games: [
                    "Resident Evil 1",
                    "Resident Evil 2",
                    "Resident Evil 3",
                    "Dino Crisis",
                    "Medal of Honor",
                    "Gran Turismo 2",
                    "Castlevania: Symphony of the Night",
                    "Metal Gear Solid",
                    "Tekken 3"
                ]
            }
        ]
    },

    {
        number: "04",
        label: "ERA 04",
        title: "A ERA DOS PCs",
        description:
            "O computador deixou de ser apenas uma máquina de trabalho e passou a ser também uma das grandes plataformas da minha vida.",
        platforms: [
            {
                year: "1994",
                type: "PC • WINDOWS 3.1",
                name: "PC 486",
                description:
                    "Meu pai tinha o computador, mas deixava eu brincar. Foi quando videogames e tecnologia começaram a andar juntos na minha cabeça.",
                games: [
                    "DOOM",
                    "Wolfenstein 3D",
                    "Duke Nukem",
                    "Hexen",
                    "Blood",
                    "Prince of Persia",
                    "Stunts",
                    "Monkey Island",
                    "Full Throttle"
                ]
            },
            {
                year: "1997",
                type: "PC • WINDOWS 95",
                name: "PC PENTIUM II",
                description:
                    "Meu primeiro computador exclusivamente meu. A partir daqui, o PC passou a ocupar um espaço cada vez maior na minha vida.",
                games: [
                    "DOOM II",
                    "Quake II",
                    "Carmageddon",
                    "Diablo",
                    "Heroes of Might and Magic III",
                    "Age of Empires",
                    "Command & Conquer: Red Alert"
                ]
            },
            {
                year: "2001",
                type: "PC • WINDOWS XP",
                name: "PC ATHLON XP",
                description:
                    "Foi onde conheci Half-Life e seus mods e também a época em que comecei a frequentar LAN houses.",
                games: [
                    "Half-Life",
                    "Team Fortress",
                    "Counter-Strike 1.5",
                    "Counter-Strike 1.6",
                    "Quake 3",
                    "Call of Duty",
                    "Max Payne",
                    "Age of Mythology"
                ]
            }
        ]
    },

    {
        number: "05",
        label: "ERA 05",
        title: "A GERAÇÃO ONLINE",
        description:
            "Os consoles e PCs começaram a conectar jogadores do mundo inteiro. Multiplayer, comunidades e novas experiências passaram a fazer parte da rotina.",
        platforms: [
            {
                year: "2002",
                type: "CONSOLE • 128-BIT",
                name: "PLAYSTATION 2",
                description:
                    "Uma geração gigantesca, cheia de jogos que ficaram marcados na história dos videogames.",
                games: [
                    "BLACK",
                    "Need for Speed Underground 2",
                    "GTA San Andreas",
                    "GTA Vice City",
                    "God of War II",
                    "Resident Evil 4",
                    "Metal Gear Solid 3"
                ]
            },
            {
                year: "2007",
                type: "CONSOLE • HD",
                name: "XBOX 360",
                description:
                    "O Xbox 360 trouxe uma nova geração de gráficos, multiplayer e experiências que definiram uma época.",
                games: [
                    "Gears of War",
                    "Halo 3",
                    "Forza Motorsport 4",
                    "Batman: Arkham City",
                    "Red Dead Redemption",
                    "Call of Duty: Modern Warfare"
                ]
            },
            {
                year: "2008",
                type: "CONSOLE • HD",
                name: "PLAYSTATION 3",
                description:
                    "Uma geração que trouxe experiências cinematográficas e alguns dos jogos mais marcantes da era HD.",
                games: [
                    "The Last of Us",
                    "God of War III",
                    "Grand Theft Auto V",
                    "Assassin's Creed III",
                    "Killzone 3",
                    "Battlefield 4",
                    "Far Cry 3",
                    "Ultimate Marvel vs. Capcom 3"
                ]
            }
        ]
    },

    {
        number: "06",
        label: "ERA 06",
        title: "A ERA MODERNA",
        description:
            "Gráficos cada vez mais impressionantes, mundos abertos gigantescos e experiências que começaram a se aproximar do cinema.",
        platforms: [
            {
                year: "2009",
                type: "PC • WINDOWS 7",
                name: "PC AMD PHENOM II X4",
                description:
                    "Uma fase importante da minha história com o PC, marcada por grandes jogos e pelo avanço do hardware.",
                games: [
                    "Call of Duty: Modern Warfare 2",
                    "Left 4 Dead 2",
                    "Fallout 3",
                    "GTA IV",
                    "Age of Empires III",
                    "Crysis",
                    "The Elder Scrolls V: Skyrim"
                ]
            },
            {
                year: "2013",
                type: "CONSOLE • 8ª GERAÇÃO",
                name: "PLAYSTATION 4",
                description:
                    "Uma das gerações mais importantes da minha trajetória, com mundos abertos enormes e experiências narrativas memoráveis.",
                games: [
                    "Red Dead Redemption 2",
                    "Grand Theft Auto V",
                    "The Last of Us Part II",
                    "God of War",
                    "Resident Evil 7",
                    "Mortal Kombat X",
                    "The Witcher 3",
                    "Uncharted 4",
                    "Ace Combat 7"
                ]
            },
            {
                year: "2020",
                type: "CONSOLE • 9ª GERAÇÃO",
                name: "XBOX SERIES S",
                description:
                    "Uma entrada na nova geração com foco em velocidade, praticidade e acesso a uma enorme biblioteca de jogos.",
                games: [
                    "Gears 5",
                    "DOOM Eternal",
                    "Halo Infinite",
                    "Forza Horizon 5",
                    "Far Cry 5"
                ]
            }
        ]
    },

    {
        number: "07",
        label: "ERA 07",
        title: "A FASE ATUAL",
        description:
            "Hoje os videogames fazem parte de algo ainda maior: jogar, transmitir, criar conteúdo, conversar e compartilhar experiências.",
        platforms: [
            {
                year: "2022",
                type: "PC • GAMER",
                name: "DELL G15",
                description:
                    "Meu PC gamer atual para jogar, transmitir e produzir conteúdo para a JorgeraTV.",
                games: [
                    "Battlefield 2042",
                    "DOOM: The Dark Ages",
                    "Counter-Strike 2",
                    "Cyberpunk 2077"
                ]
            },
            {
                year: "2023",
                type: "CONSOLE • 9ª GERAÇÃO",
                name: "PLAYSTATION 5 SLIM",
                description:
                    "Meu console principal atualmente e uma das plataformas centrais da experiência JorgeraTV.",
                games: [
                    "God of War Ragnarök",
                    "Resident Evil 4 Remake",
                    "Battlefield 6",
                    "Metal Gear Solid Delta",
                    "The Callisto Protocol"
                ]
            },
            {
                year: "2024",
                type: "CONSOLE • HÍBRIDO",
                name: "NINTENDO SWITCH LITE",
                description:
                    "Uma experiência diferente, trazendo a possibilidade de levar grandes aventuras para qualquer lugar.",
                games: [
                    "Super Mario 3D World + Bowser's Fury",
                    "Super Mario Odyssey",
                    "Mario Kart 8 Deluxe",
                    "Donkey Kong Country: Tropical Freeze",
                    "The Legend of Zelda: Tears of the Kingdom"
                ]
            }
        ]
    }
];
---

<section class="platform-timeline" id="plataformas">

    <!-- HERO -->

    <div class="platform-timeline__hero">

        <div class="platform-timeline__hero-inner">

            <span class="platform-timeline__eyebrow">
                JORGERATV • MINHA HISTÓRIA GAMER
            </span>

            <h1>
                MINHA JORNADA
                <span>PELOS VIDEOGAMES.</span>
            </h1>

            <p>
                De um Atari 2600 ao PlayStation 5 Slim e ao Dell G15.
                Mais de três décadas atravessando gerações, tecnologias,
                amizades e histórias que ficaram para sempre.
            </p>

            <div class="platform-timeline__stats">

                <div>
                    <strong>7</strong>
                    <span>Eras</span>
                </div>

                <div>
                    <strong>1990</strong>
                    <span>Início da jornada</span>
                </div>

                <div>
                    <strong>2024</strong>
                    <span>Fase atual</span>
                </div>

            </div>

        </div>

    </div>


    <!-- INTRO -->

    <div class="platform-timeline__intro">

        <span>UMA HISTÓRIA EM GERAÇÕES</span>

        <h2>
            Cada plataforma
            <strong>conta uma parte da minha história.</strong>
        </h2>

        <p>
            Alguns fizeram parte diretamente da minha vida.
            Outros chegaram através de amigos, primos, meu pai ou
            das locadoras que fizeram parte daquela época.
            Mas todos deixaram alguma lembrança.
        </p>

    </div>


    <!-- ERAS -->

    <div class="platform-eras">

        {eras.map((era) => (

            <section class="platform-era">

                <div class="platform-era__heading">

                    <div class="platform-era__number">
                        {era.number}
                    </div>

                    <div class="platform-era__heading-text">

                        <span>{era.label}</span>

                        <h2>
                            {era.title}
                        </h2>

                        <p>
                            {era.description}
                        </p>

                    </div>

                </div>


                <div class="platform-era__platforms">

                    {era.platforms.map((platform) => (

                        <article class="platform-card">

                            <div class="platform-card__top">

                                <span class="platform-card__year">
                                    {platform.year}
                                </span>

                                <span class="platform-card__type">
                                    {platform.type}
                                </span>

                            </div>

                            <h3>
                                {platform.name}
                            </h3>

                            <p class="platform-card__description">
                                {platform.description}
                            </p>


                            <div class="platform-card__games">

                                <div class="platform-card__games-title">
                                    JOGOS QUE MARCARAM ESSA FASE
                                </div>

                                <div class="platform-card__games-list">

                                    {platform.games.map((game) => (

                                        <span class="platform-game">
                                            {game}
                                        </span>

                                    ))}

                                </div>

                            </div>

                        </article>

                    ))}

                </div>

            </section>

        ))}

    </div>


    <!-- ENCERRAMENTO -->

    <div class="platform-timeline__ending">

        <span>
            E A HISTÓRIA CONTINUA
        </span>

        <h2>
            Ainda há muitos
            <strong>jogos pela frente.</strong>
        </h2>

        <p>
            A JorgeraTV é a continuação dessa jornada:
            jogar, descobrir, conversar e compartilhar
            tudo aquilo que torna os videogames especiais.
        </p>

        <p class="platform-timeline__signature">
            JorgeraTV
        </p>

    </div>

</section>

            "As plataformas que representam minha fase atual como jogador e também como criador de conteúdo.",
        platforms: [
            {
                year: "2020",
                name: "XBOX SERIES S",
                type: "Tive",
                description:
                    "Uma entrada mais compacta na nova geração, mantendo minha paixão por Xbox e seus grandes jogos.",
                games: [
                    "Gears 5",
                    "DOOM Eternal",
                    "Halo Infinite",
                    "Forza Horizon 5",
                    "Far Cry 5"
                ]
            },
            {
                year: "2022",
                name: "DELL G15",
                type: "Tenho",

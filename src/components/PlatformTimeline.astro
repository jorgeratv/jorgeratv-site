    title: "NINTENDO 64",
    type: "A chegada do 3D",
    description:
      "O Nintendo 64 foi uma verdadeira revolução. Foi uma das primeiras vezes em que senti que os mundos dos videogames estavam realmente ganhando outra dimensão.",
    games: [
      "Super Mario 64",
      "Mario Kart 64",
      "Banjo-Kazooie",
      "GoldenEye 007",
      "Donkey Kong 64",
      "Star Fox 64",
      "1080 Snowboarding",
      "Wave Race 64"
    ]
  },

  {
    year: "1997",
    title: "PC PENTIUM II + WINDOWS 95",
    type: "Meu primeiro computador",
    description:
      "Foi meu primeiro computador exclusivamente meu. A partir daqui, o PC passou a ocupar um espaço cada vez maior na minha vida.",

---
import "../styles/platform-timeline.css";

const eras = [
    {
        number: "01",
        label: "ERA 01",
        title: "OS PRIMEIROS PIXELS",
        description:
            "Foi aqui que tudo começou. Os primeiros videogames, os primeiros controles e as primeiras lembranças que ajudaram a construir minha relação com os jogos.",

        platforms: [
            {
                year: "1990",
                type: "CONSOLE • 8-BIT",
                platform: "ATARI 2600",
                description:
                    "Foi aqui que tudo começou. Meu primeiro contato com videogames e a primeira porta para um universo que nunca mais deixou de fazer parte da minha vida.",
                games: [
                    "Pitfall!",
                    "River Raid",
                    "Enduro",
                    "Frogger",
                    "Pac-Man",
                    "Adventure",
                    "H.E.R.O."
                ]
            },

            {
                year: "1993",
                type: "CONSOLE • 8-BIT",
                platform: "MASTER SYSTEM",
                description:
                    "Não tive um Master System, mas meus amigos tinham. Foi através deles que conheci alguns dos grandes clássicos da Sega.",
                highlight: "EXPERIÊNCIA ATRAVÉS DE AMIGOS",
                games: [
                    "Alex Kidd",
                    "Sonic",
                    "Shinobi",
                    "Golden Axe",
                    "Double Dragon"
                ]
            },

            {
                year: "1993",
                type: "CONSOLE • 8-BIT",
                platform: "NINTENDO NES",
                description:
                    "O Nintendo 8-bit marcou uma nova fase da minha infância e trouxe alguns dos personagens e franquias que continuam comigo até hoje.",
                games: [
                    "Super Mario Bros.",
                    "Contra",
                    "DuckTales",
                    "Mega Man 2",
                    "Castlevania",
                    "Battletoads"
                ]
            }
        ]
    },

    {
        number: "02",
        label: "ERA 02",
        title: "A ERA 16-BIT",
        description:
            "Uma geração que elevou os videogames a outro nível. Gráficos melhores, trilhas memoráveis e alguns dos jogos que mais marcaram minha infância.",

        platforms: [
            {
                year: "1993",
                type: "CONSOLE • 16-BIT",
                platform: "MEGA DRIVE",
                description:
                    "Não tive um Mega Drive. Meus primos tinham e eu aproveitava cada oportunidade para jogar.",
                highlight: "EXPERIÊNCIA ATRAVÉS DE PRIMOS",
                games: [
                    "Altered Beast",
                    "Streets of Rage",
                    "Ghouls 'n Ghosts",
                    "Earthworm Jim"
                ]
            },

            {
                year: "1994",
                type: "PC • WINDOWS 3.1",
                platform: "PC 486",
                description:
                    "Meu pai tinha o computador, mas deixava eu brincar. Foi quando videogames e tecnologia começaram a andar juntos na minha cabeça.",
                games: [
                    "DOOM",
                    "Wolfenstein 3D",
                    "Duke Nukem",
                    "Hexen",
                    "Blood",
                    "Prince of Persia",
                    "Stunts",
                    "Monkey Island",
                    "Full Throttle"
                ]
            },

            {
                year: "1994",
                type: "CONSOLE • 16-BIT",
                platform: "SUPER NINTENDO",
                description:
                    "Uma das fases mais marcantes da minha vida gamer. O Super Nintendo abriu um universo enorme de aventuras, lutas, RPGs, corridas e exploração.",
                games: [
                    "Donkey Kong Country",
                    "Super Mario World",
                    "Mortal Kombat",
                    "Street Fighter II",
                    "Chrono Trigger",
                    "Final Fantasy",
                    "Contra III",
                    "Top Gear",
                    "International Superstar Soccer Deluxe",
                    "Final Fight",
                    "Sunset Riders",
                    "Aladdin",
                    "Legend of Mana",
                    "Super Metroid",
                    "Demon's Crest"
                ]
            }
        ]
    },

    {
        number: "03",
        label: "ERA 03",
        title: "A REVOLUÇÃO 3D",
        description:
            "Os videogames começaram a ganhar uma nova dimensão. Arcades, locadoras e consoles que ajudaram a transformar a experiência de jogar.",

        platforms: [
            {
                year: "1995",
                type: "CONSOLE • 32-BIT",
                platform: "3DO",
                description:
                    "Não tive um 3DO, mas conheci a plataforma em uma locadora. Eu pagava por hora e aproveitava cada minuto para descobrir aquela tecnologia diferente.",
                highlight: "CONTATO ATRAVÉS DE LOCADORA",
                games: [
                    "Road Rash",
                    "The Need for Speed",
                    "Alone in the Dark",
                    "Gex",
                    "FIFA International Soccer",
                    "Super Street Fighter II Turbo"
                ]
            },

            {
                year: "1995",
                type: "CONSOLE • 32-BIT",
                platform: "NEO GEO CD",
                description:
                    "Outra experiência de locadora que ficou marcada. O Neo Geo era praticamente um sonho para quem gostava dos arcades.",
                highlight: "CONTATO ATRAVÉS DE LOCADORA",
                games: [
                    "The King of Fighters '95",
                    "The King of Fighters '96",
                    "Metal Slug",
                    "Samurai Shodown II",
                    "Fatal Fury Special",
                    "Super Sidekicks 3"
                ]
            },

            {
                year: "1997",
                type: "PC • WINDOWS 95",
                platform: "PC PENTIUM II",
                description:
                    "Meu primeiro computador exclusivamente meu. A partir daqui, o PC passou a ocupar um espaço cada vez maior na minha vida.",
                games: [
                    "DOOM II",
                    "Quake II",
                    "Carmageddon",
                    "Diablo",
                    "Heroes of Might and Magic III",
                    "Age of Empires",
                    "Command & Conquer: Red Alert"
                ]
            },

            {
                year: "1997",
                type: "CONSOLE • 64-BIT",
                platform: "NINTENDO 64",
                description:
                    "O Nintendo 64 foi uma verdadeira revolução. Foi uma das primeiras vezes em que senti que os mundos dos videogames estavam realmente ganhando outra dimensão.",
                games: [
                    "Super Mario 64",
                    "Mario Kart 64",
                    "Banjo-Kazooie",
                    "GoldenEye 007",
                    "Donkey Kong 64",
                    "Star Fox 64",
                    "1080 Snowboarding",
                    "Wave Race 64"
                ]
            },

            {
                year: "1998",
                type: "CONSOLE • 32-BIT",
                platform: "PLAYSTATION 1",
                description:
                    "O PlayStation trouxe uma quantidade absurda de experiências diferentes e ajudou a consolidar ainda mais minha paixão por videogames.",
                games: [
                    "Resident Evil",
                    "Resident Evil 2",
                    "Resident Evil 3",
                    "Dino Crisis",
                    "Medal of Honor",
                    "Gran Turismo 2",
                    "Castlevania: Symphony of the Night",
                    "Metal Gear Solid",
                    "Tekken 3"
                ]
            }
        ]
    },

    {
        number: "04",
        label: "ERA 04",
        title: "A GERAÇÃO 128-BIT",
        description:
            "Uma geração que trouxe mundos maiores, experiências mais cinematográficas e uma nova forma de viver os videogames.",

        platforms: [
            {
                year: "2000",
                type: "CONSOLE • 128-BIT",
                platform: "PLAYSTATION 2",
                description:
                    "O PlayStation 2 acompanhou uma das épocas mais importantes da indústria dos videogames e trouxe alguns dos jogos que mais me marcaram.",
                games: [
                    "Gran Turismo",
                    "God of War",
                    "GTA",
                    "Metal Gear Solid",
                    "Resident Evil"
                ]
            },

            {
                year: "2001",
                type: "CONSOLE",
                platform: "XBOX",
                description:
                    "A chegada da Microsoft aos consoles trouxe uma nova experiência para minha jornada gamer.",
                games: [
                    "Halo",
                    "Halo 2",
                    "Forza Motorsport",
                    "Fable",
                    "Ninja Gaiden"
                ]
            },

            {
                year: "2001",
                type: "PC • WINDOWS XP",
                platform: "PC ATHLON XP",
                description:
                    "Foi onde conheci Half-Life e seus mods e também a época em que comecei a frequentar LAN houses.",
                games: [
                    "Half-Life",
                    "Team Fortress",
                    "Counter-Strike 1.5",
                    "Counter-Strike 1.6",
                    "Quake III Arena",
                    "Call of Duty",
                    "Max Payne",
                    "Age of Mythology"
                ]
            }
        ]
    },

    {
        number: "05",
        label: "ERA 05",
        title: "A ERA HD",
        description:
            "A alta definição mudou a maneira de enxergar os videogames e trouxe uma nova geração de experiências online.",

        platforms: [
            {
                year: "2006",
                type: "CONSOLE • HD",
                platform: "PLAYSTATION 3",
                description:
                    "Uma geração marcada por grandes aventuras, mundos abertos e experiências cinematográficas.",
                games: [
                    "The Last of Us",
                    "God of War III",
                    "Grand Theft Auto V",
                    "Assassin's Creed III",
                    "Killzone 3",
                    "Battlefield 4",
                    "Far Cry 3",
                    "Ultimate Marvel vs. Capcom 3"
                ]
            },

            {
                year: "2007",
                type: "CONSOLE • HD",
                platform: "XBOX 360",
                description:
                    "O Xbox 360 trouxe uma nova geração de gráficos, multiplayer e experiências que definiram uma época.",
                games: [
                    "Gears of War",
                    "Halo 3",
                    "Forza Motorsport 4",
                    "Batman: Arkham City",
                    "Red Dead Redemption",
                    "Call of Duty: Modern Warfare"
                ]
            },

            {
                year: "2010",
                type: "PC • WINDOWS 7",
                platform: "PC AMD PHENOM II X4",
                description:
                    "Uma nova fase do PC, acompanhando a evolução dos jogos e das tecnologias que passaram a fazer parte da minha experiência gamer.",
                games: [
                    "Call of Duty: Modern Warfare 2",
                    "Left 4 Dead 2",
                    "Fallout 3",
                    "GTA IV",
                    "Age of Empires III",
                    "Crysis",
                    "The Elder Scrolls V: Skyrim"
                ]
            }
        ]
    },

    {
        number: "06",
        label: "ERA 06",
        title: "A GERAÇÃO ATUAL",
        description:
            "Hoje, videogames, tecnologia, criação de conteúdo e novas formas de jogar fazem parte da mesma experiência.",

        platforms: [
            {
                year: "2013",
                type: "CONSOLE",
                platform: "PLAYSTATION 4",
                description:
                    "O PlayStation 4 trouxe uma combinação incrível de mundos abertos, histórias cinematográficas, ação e experiências multiplayer.",
                games: [
                    "Red Dead Redemption 2",
                    "Grand Theft Auto V",
                    "The Last of Us Part II",
                    "God of War",
                    "Resident Evil 7",
                    "Mortal Kombat X",
                    "The Witcher 3",
                    "Uncharted 4",
                    "Ace Combat 7"
                ]
            },

            {
                year: "2020",
                type: "CONSOLE • CURRENT GEN",
                platform: "XBOX SERIES S",
                description:
                    "Uma entrada mais compacta na nova geração, mantendo minha paixão por Xbox e seus grandes exclusivos e multiplataformas.",
                games: [
                    "Gears 5",
                    "DOOM Eternal",
                    "Halo Infinite",
                    "Forza Horizon 5",
                    "Far Cry 5"
                ]
            },

            {
                year: "2020",
                type: "PORTÁTIL • CURRENT GEN",
                platform: "NINTENDO SWITCH LITE",
                description:
                    "Uma forma diferente de continuar conectado aos universos da Nintendo, agora em uma experiência portátil.",
                games: [
                    "Super Mario 3D World + Bowser's Fury",
                    "Super Mario Odyssey",
                    "Mario Kart 8 Deluxe",
                    "Donkey Kong Country: Tropical Freeze",
                    "The Legend of Zelda: Tears of the Kingdom"
                ]
            },

            {
                year: "2024",
                type: "PC GAMER",
                platform: "DELL G15",
                description:
                    "Meu PC gamer atual. É nele que a experiência gamer se encontra com criação de conteúdo, gravação, transmissões e produção da JorgeraTV.",
                games: [
                    "Battlefield 6",
                    "DOOM: The Dark Ages",
                    "Counter-Strike 2",
                    "Cyberpunk 2077"
                ]
            },

            {
                year: "2024",
                type: "CONSOLE • CURRENT GEN",
                platform: "PLAYSTATION 5 SLIM",
                description:
                    "Meu console atual e uma das principais plataformas da minha experiência gamer hoje.",
                games: [
                    "God of War Ragnarök",
                    "Resident Evil 4 Remake",
                    "Battlefield 6",
                    "Metal Gear Solid Delta",
                    "The Callisto Protocol"
                ]
            }
        ]
    }
];

const totalPlatforms = eras.reduce(
    (total, era) => total + era.platforms.length,
    0
);
---

<section class="platform-timeline">

    <!-- =========================================================
         HERO
    ========================================================== -->

    <div class="platform-timeline__hero">
        <div class="platform-timeline__hero-inner">

            <span class="platform-timeline__eyebrow">
                JORGERATV • MINHA HISTÓRIA GAMER
            </span>

            <h1>
                MINHA JORNADA
                <span>PELOS VIDEOGAMES.</span>
            </h1>

            <p>
                De um Atari 2600 ao PlayStation 5 Slim e ao Dell G15.
                Mais de três décadas atravessando gerações, tecnologias,
                amizades e histórias que ficaram para sempre.
            </p>

            <div class="platform-timeline__stats">

                <div>
                    <strong>{totalPlatforms}</strong>
                    <span>PLATAFORMAS</span>
                </div>

                <div>
                    <strong>1990</strong>
                    <span>INÍCIO DA JORNADA</span>
                </div>

                <div>
                    <strong>2024</strong>
                    <span>FASE ATUAL</span>
                </div>

            </div>

        </div>
    </div>


    <!-- =========================================================
         INTRO
    ========================================================== -->

    <div class="platform-timeline__intro">

        <span>UMA HISTÓRIA EM GERAÇÕES</span>

        <h2>
            Cada plataforma
            <strong>conta uma parte da minha história.</strong>
        </h2>

        <p>
            Alguns fizeram parte diretamente da minha vida.
            Outros chegaram através de amigos, primos, meu pai
            ou das locadoras que fizeram parte daquela época.
            Mas todos deixaram alguma lembrança.
        </p>

    </div>


    <!-- =========================================================
         ERAS — ORDEM CRONOLÓGICA
    ========================================================== -->

    <div class="platform-timeline__container">

        {eras.map((era) => (

            <section class="timeline-era">

                <div class="timeline-era__header">

                    <div class="timeline-era__number">
                        {era.number}
                    </div>

                    <div class="timeline-era__heading">

                        <span class="timeline-era__label">
                            {era.label}
                        </span>

                        <h2>
                            {era.title}
                        </h2>

                        <p>
                            {era.description}
                        </p>

                    </div>

                </div>


                <div class="timeline-era__grid">

                    {era.platforms.map((item) => (

                        <article class="timeline-card">

                            <div class="timeline-card__top">

                                <span class="timeline-card__year">
                                    {item.year}
                                </span>

                                <span class="timeline-card__type">
                                    {item.type}
                                </span>

                            </div>


                            <h3>
                                {item.platform}
                            </h3>


                            <p class="timeline-card__description">
                                {item.description}
                            </p>


                            {item.highlight && (

                                <div class="timeline-card__highlight">
                                    {item.highlight}
                                </div>

                            )}


                            <div class="timeline-games">

                                <div class="timeline-games__title">
                                    JOGOS QUE MARCARAM ESSA FASE
                                </div>

                                <div class="timeline-games__list">

                                    {item.games.map((game) => (

                                        <span class="timeline-game">
                                            {game}
                                        </span>

                                    ))}

                                </div>

                            </div>

                        </article>

                    ))}

                </div>

            </section>

        ))}

    </div>


    <!-- =========================================================
         FINAL
    ========================================================== -->

    <div class="platform-timeline__ending">

        <small>
            E AINDA NÃO TERMINOU
        </small>

        <h2>
            A história continua.
            <span>Próxima fase...</span>
        </h2>

        <p>
            De um Atari 2600 até o PlayStation 5, passando por
            locadoras, LAN houses, computadores, consoles e milhares
            de horas de diversão. A tecnologia mudou.
            Os jogos mudaram.
            Mas aquela paixão de quando tudo começou continua aqui.
        </p>

    </div>

</section>

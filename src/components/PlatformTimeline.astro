---

<section class="platform-timeline">

  <div class="platform-container">

    <!-- HERO -->
    <header class="platform-hero">

      <div class="platform-hero-label">
        JORGERATV • MINHA HISTÓRIA GAMER
      </div>

      <h1>
        MINHA JORNADA<br />
        PELOS VIDEOGAMES.
      </h1>

      <p>
        De um Atari 2600 ao PlayStation 5 e ao PC gamer.
        Mais de três décadas atravessando gerações,
        tecnologias, amizades e histórias que ficaram para sempre.
      </p>

      <div class="platform-stats">

        <div>
          <strong>21</strong>
          <span>Plataformas</span>
        </div>

        <div>
          <strong>1990</strong>
          <span>Primeiro contato</span>
        </div>

        <div>
          <strong>2024</strong>
          <span>Fase atual</span>
        </div>

      </div>

    </header>


    <!-- INTRODUÇÃO -->
    <div class="platform-intro">

      <div class="platform-intro-number">
        01
      </div>

      <div>

        <span>UMA HISTÓRIA EM GERAÇÕES</span>

        <h2>
          Cada plataforma conta<br />
          uma parte da história.
        </h2>

        <p>
          Alguns eu tive. Outros pertenciam a amigos, primos,
          meu pai ou às locadoras que fizeram parte daquela época.
          Mas todos eles contribuíram de alguma forma para construir
          a minha relação com os videogames.
        </p>

      </div>

    </div>


    <!-- ERAS -->
    <div class="platform-eras">

      {eras.map((era, eraIndex) => (

        <section class="platform-era">

          <div class="era-heading">

            <div class="era-number">
              {era.number}
            </div>

            <div class="era-heading-content">

              <span>{era.label}</span>

              <h2>{era.title}</h2>

              <p>{era.description}</p>

            </div>

          </div>


          <div class="platform-grid">

            {era.platforms.map((platform) => (

              <article class="platform-card">

                <div class="platform-card-top">

                  <span class="platform-year">
                    {platform.year}
                  </span>

                  <span class="platform-category">
                    {platform.category}
                  </span>

                </div>


                <h3>
                  {platform.name}
                </h3>


                <p class="platform-description">
                  {platform.description}
                </p>


                {platform.note && (
                  <div class="platform-note">
                    {platform.note}
                  </div>
                )}


                <div class="games-section">

                  <span class="games-label">
                    JOGOS QUE MARCARAM ESSA FASE
                  </span>

                  <div class="games-list">

                    {platform.games.map((game) => (
                      <span class="game">
                        {game}
                      </span>
                    ))}

                  </div>

                </div>

              </article>

            ))}

          </div>

        </section>

      ))}

    </div>

  </div>

</section>

---
import "../styles/platform-timeline.css";

const platforms = [

    {
        year: "1990",
        platform: "ATARI 2600",
        type: "Primeiro videogame",
        status: "Tive",
        description:
            "Foi aqui que tudo começou. Meu primeiro contato com videogames e a primeira porta para um universo que nunca mais deixou de fazer parte da minha vida.",
        games: [
            "Pitfall!",
            "River Raid",
            "Enduro",
            "Frogger",
            "Pac-Man",
            "Adventure",
            "H.E.R.O."
        ]
    },

    {
        year: "1993",
        platform: "MASTER SYSTEM",
        type: "Primeiros contatos",
        status: "Jogava com amigos",
        description:
            "Eu não tinha um Master System, mas meus amigos tinham. E foi através deles que conheci alguns dos grandes clássicos da Sega.",
        games: [
            "Alex Kidd",
            "Sonic",
            "Shinobi",
            "Golden Axe",
            "Double Dragon"
        ]
    },

    {
        year: "1993",
        platform: "NES",
        type: "Nintendo 8-bit",
        status: "Tive",
        description:
            "O Nintendo 8-bit marcou uma nova fase da minha infância e trouxe alguns dos personagens e franquias que continuam comigo até hoje.",
        games: [
            "Super Mario Bros.",
            "Contra",
            "DuckTales",
            "Mega Man 2",
            "Castlevania",
            "Battletoads"
        ]
    },

    {
        year: "1993",
        platform: "MEGA DRIVE",
        type: "Primeiros contatos",
        status: "Jogava com primos",
        description:
            "Assim como o Master System, não tive um Mega Drive. Meus primos tinham e eu aproveitava cada oportunidade para jogar.",
        games: [
            "Altered Beast",
            "Streets of Rage",
            "Ghouls 'n Ghosts",
            "Earthworm Jim"
        ]
    },

    {
        year: "1994",
        platform: "SUPER NINTENDO",
        type: "Uma geração inesquecível",
        status: "Tive",
        description:
            "Uma das fases mais marcantes da minha vida gamer. O Super Nintendo abriu um universo enorme de aventuras, lutas, RPGs, corridas e exploração.",
        games: [
            "Donkey Kong Country",
            "Super Mario World",
            "Mortal Kombat",
            "Street Fighter",
            "Chrono Trigger",
            "Final Fantasy",
            "Contra III",
            "Top Gear",
            "International Superstar Soccer Deluxe",
            "Final Fight",
            "Sunset Riders",
            "Aladdin",
            "Legend of Mana",
            "Super Metroid",
            "Demon's Crest"
        ]
    },

    {
        year: "1994",
        platform: "PC 486 + WINDOWS 3.1",
        type: "Tecnologia e descoberta",
        status: "Computador do meu pai",
        description:
            "Meu pai tinha o computador, mas deixava eu brincar. Foi quando videogames e tecnologia começaram a andar juntos na minha cabeça.",
        games: [
            "DOOM",
            "Wolfenstein 3D",
            "Duke Nukem",
            "Hexen",
            "Blood",
            "Prince of Persia",
            "Stunts",
            "Monkey Island",
            "Full Throttle"
        ]
    },

    {
        year: "1995",
        platform: "3DO",
        type: "Experiência de locadora",
        status: "Jogava pagando por hora",
        description:
            "Não tive um 3DO, mas conheci a plataforma em uma locadora. Eu pagava por hora e aproveitava cada minuto para descobrir aquela tecnologia diferente.",
        games: [
            "Road Rash",
            "The Need for Speed",
            "DOOM",
            "Super Street Fighter II Turbo"
        ]
    },

    {
        year: "1995",
        platform: "NEO GEO CD",
        type: "Experiência de locadora",
        status: "Jogava pagando por hora",
        description:
            "Outra experiência de locadora que ficou marcada. O Neo Geo era praticamente um sonho para quem gostava dos arcades.",
        games: [
            "The King of Fighters '95",
            "The King of Fighters '96",
            "Metal Slug",
            "Samurai Shodown III",
            "Fatal Fury Special",
            "Super Sidekicks 3"
        ]
    },

    {
        year: "1997",
        platform: "NINTENDO 64",
        type: "A chegada do 3D",
        status: "Tive",
        description:
            "O Nintendo 64 foi uma verdadeira revolução. Foi uma das primeiras vezes em que senti que os mundos dos videogames estavam realmente ganhando outra dimensão.",
        games: [
            "Super Mario 64",
            "Mario Kart 64",
            "Banjo-Kazooie",
            "GoldenEye 007",
            "Donkey Kong 64",
            "Star Fox 64",
            "1080 Snowboarding",
            "Wave Race 64"
        ]
    },

    {
        year: "1997",
        platform: "PC PENTIUM II + WINDOWS 95",
        type: "Meu primeiro PC",
        status: "Primeiro computador exclusivamente meu",
        description:
            "Foi meu primeiro computador exclusivamente meu. A partir daqui, o PC passou a ocupar um espaço cada vez maior na minha vida.",
        games: [
            "DOOM II",
            "Quake II",
            "Carmageddon",
            "Diablo",
            "Heroes of Might and Magic III",
            "Age of Empires",
            "Command & Conquer: Red Alert"
        ]
    },

    {
        year: "1998",
        platform: "PLAYSTATION 1",
        type: "Uma nova era",
        status: "Tive",
        description:
            "O PlayStation trouxe uma quantidade absurda de experiências diferentes e ajudou a consolidar ainda mais minha paixão por videogames.",
        games: [
            "Resident Evil",
            "Resident Evil 2",
            "Resident Evil 3",
            "Dino Crisis",
            "Medal of Honor",
            "Gran Turismo 2",
            "Castlevania: Symphony of the Night",
            "Metal Gear Solid",
            "Tekken 3"
        ]
    },

    {
        year: "2001",
        platform: "PC ATHLON XP + WINDOWS XP",
        type: "A era das LAN Houses",
        status: "Meu PC",
        description:
            "Foi nesse computador que conheci Half-Life e seus mods. Também foi quando comecei a frequentar LAN Houses e a jogar competitivamente em nível amador.",
        games: [
            "Half-Life",
            "Team Fortress",
            "Counter-Strike 1.5",
            "Counter-Strike 1.6",
            "Quake III Arena",
            "Call of Duty",
            "Max Payne",
            "Age of Mythology"
        ]
    },

    {
        year: "2002",
        platform: "PLAYSTATION 2",
        type: "Uma geração histórica",
        status: "Tive",
        description:
            "O PlayStation 2 acompanhou uma das épocas mais importantes da indústria dos videogames e trouxe alguns dos jogos que mais me marcaram.",
        games: [
            "Black",
            "Need for Speed Underground 2",
            "GTA: San Andreas",
            "GTA: Vice City",
            "God of War II",
            "Resident Evil 4",
            "Metal Gear Solid 3"
        ]
    },

    {
        year: "2006",
        platform: "XBOX 360",
        type: "Nova geração",
        status: "Tive",
        description:
            "O Xbox 360 trouxe uma nova geração de gráficos, multiplayer e experiências que definiram uma época.",
        games: [
            "Gears of War",
            "Halo 3",
            "Forza Motorsport 4",
            "Batman: Arkham City",
            "Red Dead Redemption",
            "Call of Duty: Modern Warfare"
        ]
    },

    {
        year: "2008",
        platform: "PLAYSTATION 3",
        type: "Alta definição",
        status: "Tive",
        description:
            "Uma geração marcada por grandes aventuras, mundos abertos e experiências cinematográficas.",
        games: [
            "The Last of Us",
            "God of War III",
            "Grand Theft Auto V",
            "Assassin's Creed III",
            "Killzone 3",
            "Battlefield 4",
            "Far Cry 3",
            "Ultimate Marvel vs. Capcom 3"
        ]
    },

    {
        year: "2009",
        platform: "PC AMD PHENOM II X4 + WINDOWS 7",
        type: "PC Gaming",
        status: "Meu PC",
        description:
            "Mais uma evolução importante no PC. Foi uma época de grandes experiências multiplayer e jogos tecnicamente impressionantes.",
        games: [
            "Call of Duty: Modern Warfare 2",
            "Left 4 Dead 2",
            "Fallout 3",
            "GTA IV",
            "Age of Empires III",
            "Crysis",
            "The Elder Scrolls V: Skyrim"
        ]
    },

    {
        year: "2013",
        platform: "PLAYSTATION 4",
        type: "Uma das minhas gerações favoritas",
        status: "Tive",
        description:
            "O PlayStation 4 trouxe uma combinação incrível de mundos abertos, histórias cinematográficas, ação e experiências multiplayer.",
        games: [
            "Red Dead Redemption 2",
            "Grand Theft Auto V",
            "The Last of Us Part II",
            "God of War",
            "Resident Evil 7",
            "Mortal Kombat X",
            "The Witcher 3",
            "Uncharted 4",
            "Ace Combat 7"
        ]
    },

    {
        year: "2020",
        platform: "XBOX SERIES S",
        type: "Nova geração",
        status: "Tive",
        description:
            "Uma entrada mais compacta na nova geração, mantendo minha paixão por Xbox e seus grandes exclusivos e multiplataformas.",
        games: [
            "Gears 5",
            "DOOM Eternal",
            "Halo Infinite",
            "Forza Horizon 5",
            "Far Cry 5"
        ]
    },

    {
        year: "2022",
        platform: "DELL G15",
        type: "Meu PC atual",
        status: "Tenho",
        description:
            "O PC que representa minha fase atual como gamer e também como criador de conteúdo da JorgeraTV.",
        games: [
            "Battlefield 2042",
            "DOOM: The Dark Ages",
            "Counter-Strike 2",
            "Cyberpunk 2077"
        ]
    },

    {
        year: "2023",
        platform: "PLAYSTATION 5 SLIM",
        type: "Minha geração atual",
        status: "Tenho",
        description:
            "Hoje, o PlayStation 5 Slim é uma das principais plataformas da minha experiência gamer atual.",
        games: [
            "God of War Ragnarök",
            "Resident Evil 4 Remake",
            "Battlefield 6",
            "Metal Gear Solid Delta",
            "The Callisto Protocol"
        ]
    },

    {
        year: "2024",
        platform: "NINTENDO SWITCH LITE",
        type: "Nintendo na era portátil",
        status: "Tenho",
        description:
            "Uma forma diferente de continuar conectado aos universos da Nintendo, agora em uma experiência portátil.",
        games: [
            "Super Mario 3D World + Bowser's Fury",
            "Super Mario Odyssey",
            "Mario Kart 8 Deluxe",
            "Donkey Kong Country: Tropical Freeze",
            "The Legend of Zelda: Tears of the Kingdom"
        ]
    }

];
---

<section class="platform-timeline">

    <div class="platform-timeline__hero">

        <div class="platform-timeline__hero-inner">

            <span class="platform-timeline__eyebrow">
                JORGERATV • MINHA HISTÓRIA GAMER
            </span>

            <h1>
                UMA VIDA
                <span>JOGANDO.</span>
            </h1>

            <p>
                De um Atari 2600 a um PlayStation 5 e um PC gamer.
                Mais de três décadas atravessando gerações,
                tecnologias, amizades e histórias que ficaram para sempre.
            </p>

            <div class="platform-timeline__stats">

                <div>
                    <strong>{platforms.length}</strong>
                    <span>Plataformas</span>
                </div>

                <div>
                    <strong>1990</strong>
                    <span>Primeiro contato</span>
                </div>

                <div>
                    <strong>2024</strong>
                    <span>Fase atual</span>
                </div>

            </div>

        </div>

    </div>


    <div class="platform-timeline__intro">

        <span>UMA JORNADA</span>

        <h2>
            Cada plataforma
            <strong>conta uma parte da história.</strong>
        </h2>

        <p>
            Alguns eu tive. Outros pertenciam a amigos, primos,
            meu pai ou às locadoras que fizeram parte daquela época.
            Mas todos eles contribuíram de alguma forma para construir
            a minha relação com os videogames.
        </p>

    </div>


    <div class="platform-timeline__container">

        <div class="platform-timeline__line"></div>

        {platforms.map((item, index) => (

            <article
                class:list={[
                    "timeline-item",
                    index % 2 === 0
                        ? "timeline-item--left"
                        : "timeline-item--right"
                ]}
            >

                <div class="timeline-marker">
                    <span>{index + 1}</span>
                </div>


                <div class="timeline-content">

                    <div class="timeline-year">
                        {item.year}
                    </div>

                    <div class="timeline-card">

                        <div class="timeline-card__top">

                            <span class="timeline-card__type">
                                {item.type}
                            </span>

                            <span class="timeline-card__status">
                                {item.status}
                            </span>

                        </div>


                        <h3>
                            {item.platform}
                        </h3>


                        <p class="timeline-card__description">
                            {item.description}
                        </p>


                        <div class="timeline-games">

                            <div class="timeline-games__title">
                                JOGOS QUE MARCARAM ESSA FASE
                            </div>

                            <div class="timeline-games__list">

                                {item.games.map((game) => (

                                    <span class="timeline-game">
                                        {game}
                                    </span>

                                ))}

                            </div>

                        </div>

                    </div>

                </div>

            </article>

        ))}

    </div>


    <div class="platform-timeline__ending">

        <span>CONTINUA...</span>

        <h2>
            A história ainda
            <strong>está sendo escrita.</strong>
        </h2>

        <p>
            Os consoles mudaram. Os computadores evoluíram.
            A tecnologia ficou cada vez mais impressionante.
            Mas uma coisa permaneceu igual desde 1990:
            a vontade de jogar.
        </p>

        <p class="platform-timeline__signature">
            E essa história agora também faz parte da JorgeraTV.
        </p>

    </div>

</section>

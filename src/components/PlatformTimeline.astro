---

<section class="platform-page">

  <!-- HERO -->
  <header class="platform-hero">

    <div class="hero-eyebrow">
      <span>🎮</span>
      <span>A HISTÓRIA DA JORGERATV</span>
    </div>

    <h1>
      Uma vida<br />
      <span>jogando.</span>
    </h1>

    <p class="hero-description">
      Antes dos gráficos em 4K, dos SSDs e do multiplayer online,
      existiam cartuchos, locadoras, fitas e tardes inteiras jogando.
      Esta é a linha do tempo da minha história com games.
    </p>

    <div class="hero-stats">
      <div class="stat">
        <strong>{platforms.length}</strong>
        <span>PLATAFORMAS</span>
      </div>

      <div class="stat">
        <strong>1990</strong>
        <span>PRIMEIRO CONTATO</span>
      </div>

      <div class="stat">
        <strong>2024</strong>
        <span>ATUAL</span>
      </div>
    </div>

  </header>


  <!-- TIMELINE -->
  <div class="timeline">

    <div class="timeline-line"></div>

    {
      platforms.map((platform, index) => (
        <article
          class={`timeline-item ${index % 2 === 0 ? "left" : "right"}`}
        >

          <!-- MARCADOR -->
          <div class="timeline-marker">
            <span>{String(index + 1).padStart(2, "0")}</span>
          </div>


          <!-- ANO -->
          <div class="timeline-year">
            {platform.year}
          </div>


          <!-- CARD -->
          <div class="platform-card">

            <div class="card-top">

              <div class="platform-type">
                <span>{platform.icon}</span>
                {platform.type}
              </div>

              <div class="generation">
                {platform.generation}
              </div>

            </div>


            <div class="card-heading">

              <h2>{platform.name}</h2>

              <div class="ownership">
                {platform.ownership}
              </div>

            </div>


            <div class="games-section">

              <div class="games-label">
                <span>JOGOS</span>
                <i></i>
              </div>

              <div class="games-list">

                {
                  platform.games.map((game) => (
                    <span class="game">
                      {game}
                    </span>
                  ))
                }

              </div>

            </div>


            <div class="card-number">
              {String(index + 1).padStart(2, "0")}
            </div>

          </div>

        </article>
      ))
    }

  </div>


  <!-- FINAL -->
  <section class="timeline-ending">

    <div class="ending-eyebrow">
      <span>FIM?</span>
      <i></i>
    </div>

    <h2>
      A história<br />
      <span>continua.</span>
    </h2>

    <p>
      De um Atari em 1990 a uma geração de consoles, PCs e jogos
      cada vez mais imersivos. A tecnologia mudou. A vontade de jogar,
      não.
    </p>

  </section>

</section>


<style>

  /* =========================================================
     BASE
  ========================================================= */

  .platform-page {
    position: relative;
    width: 100%;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 85% 8%,
        rgba(180, 0, 20, 0.12),
        transparent 34%
      ),
      #050505;
    color: #f4eee5;
  }


  /* =========================================================
     HERO
  ========================================================= */

  .platform-hero {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    padding: 110px 48px 130px;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;

    color: #ff2638;

    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-eyebrow span:first-child {
    font-size: 15px;
  }

  .platform-hero h1 {
    max-width: 850px;
    margin: 0;

    font-size: clamp(72px, 9vw, 142px);
    line-height: 0.86;
    font-weight: 900;
    letter-spacing: -0.065em;
  }

  .platform-hero h1 span {
    color: #ff2638;
  }

  .hero-description {
    max-width: 700px;
    margin: 48px 0 0;

    color: #a8a3a0;

    font-size: 19px;
    line-height: 1.7;
    letter-spacing: -0.01em;
  }

  .hero-stats {
    display: flex;
    gap: 80px;
    margin-top: 68px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .stat strong {
    font-size: 46px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .stat span {
    color: #777270;

    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }


  /* =========================================================
     TIMELINE
  ========================================================= */

  .timeline {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    padding: 30px 48px 160px;
  }

  .timeline-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;

    background:
      linear-gradient(
        to bottom,
        transparent,
        rgba(255, 38, 56, 0.45) 5%,
        rgba(255, 38, 56, 0.18) 95%,
        transparent
      );

    transform: translateX(-50%);
  }


  /* =========================================================
     TIMELINE ITEM
  ========================================================= */

  .timeline-item {
    position: relative;
    display: grid;

    grid-template-columns: 1fr 1fr;

    min-height: 360px;
    margin-bottom: 90px;
  }

  .timeline-item.left .platform-card {
    grid-column: 1;
    margin-right: 70px;
  }

  .timeline-item.right .platform-card {
    grid-column: 2;
    margin-left: 70px;
  }


  /* =========================================================
     MARCADOR
  ========================================================= */

  .timeline-marker {
    position: absolute;
    z-index: 4;

    top: 34px;
    left: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 56px;
    height: 56px;

    border: 1px solid rgba(255, 38, 56, 0.45);
    border-radius: 50%;

    background: #070707;

    transform: translateX(-50%);
  }

  .timeline-marker::after {
    content: "";

    position: absolute;

    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: #ff2638;

    box-shadow: 0 0 20px rgba(255, 38, 56, 0.65);
  }

  .timeline-marker span {
    position: absolute;

    top: 67px;

    color: #625c59;

    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }


  /* =========================================================
     ANO
  ========================================================= */

  .timeline-year {
    position: absolute;
    top: 4px;

    color: #ff2638;

    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.15em;
  }

  .timeline-item.left .timeline-year {
    right: calc(50% + 100px);
  }

  .timeline-item.right .timeline-year {
    left: calc(50% + 100px);
  }


  /* =========================================================
     CARD
  ========================================================= */

  .platform-card {
    position: relative;

    min-height: 330px;

    padding: 34px 36px 38px;

    border: 1px solid rgba(255, 255, 255, 0.055);
    border-radius: 18px;

    background:
      linear-gradient(
        145deg,
        rgba(255, 255, 255, 0.035),
        rgba(255, 255, 255, 0.008)
      );

    box-shadow:
      0 25px 80px rgba(0, 0, 0, 0.25);

    overflow: hidden;

    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
      background 0.35s ease;
  }

  .platform-card::before {
    content: "";

    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: 2px;

    background:
      linear-gradient(
        90deg,
        transparent,
        #ff2638,
        transparent
      );

    opacity: 0;

    transition: opacity 0.35s ease;
  }

  .platform-card:hover {
    transform: translateY(-6px);

    border-color: rgba(255, 38, 56, 0.24);

    background:
      linear-gradient(
        145deg,
        rgba(255, 38, 56, 0.055),
        rgba(255, 255, 255, 0.012)
      );
  }

  .platform-card:hover::before {
    opacity: 1;
  }


  /* =========================================================
     CARD TOP
  ========================================================= */

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding-bottom: 22px;

    border-bottom: 1px solid rgba(255, 255, 255, 0.055);
  }

  .platform-type {
    display: flex;
    align-items: center;
    gap: 9px;

    color: #ff2638;

    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.14em;
  }

  .platform-type span {
    font-size: 15px;
  }

  .generation {
    color: #67615f;

    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }


  /* =========================================================
     CARD HEADING
  ========================================================= */

  .card-heading {
    margin-top: 25px;
  }

  .card-heading h2 {
    margin: 0;

    color: #f3ede4;

    font-size: clamp(30px, 3vw, 48px);
    line-height: 0.98;
    font-weight: 900;
    letter-spacing: -0.045em;
  }

  .ownership {
    max-width: 560px;
    margin-top: 14px;

    color: #8c8784;

    font-size: 12px;
    line-height: 1.55;
  }


  /* =========================================================
     JOGOS
  ========================================================= */

  .games-section {
    margin-top: 30px;
  }

  .games-label {
    display: flex;
    align-items: center;
    gap: 10px;

    margin-bottom: 15px;

    color: #77716e;

    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0.16em;
  }

  .games-label i {
    display: block;

    width: 28px;
    height: 1px;

    background: #ff2638;
  }

  .games-list {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .game {
    display: inline-flex;
    align-items: center;

    padding: 8px 11px;

    border: 1px solid rgba(255, 255, 255, 0.065);
    border-radius: 6px;

    background: rgba(255, 255, 255, 0.018);

    color: #aaa4a0;

    font-size: 11px;
    line-height: 1.2;

    transition:
      color 0.25s ease,
      border-color 0.25s ease,
      background 0.25s ease;
  }

  .game:hover {
    border-color: rgba(255, 38, 56, 0.35);

    background: rgba(255, 38, 56, 0.07);

    color: #f4eee5;
  }


  /* =========================================================
     CARD NUMBER
  ========================================================= */

  .card-number {
    position: absolute;

    right: 22px;
    bottom: 17px;

    color: rgba(255, 255, 255, 0.025);

    font-size: 70px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: -0.08em;

    pointer-events: none;
  }


  /* =========================================================
     FINAL
  ========================================================= */

  .timeline-ending {
    position: relative;

    max-width: 1280px;

    margin: 0 auto;

    padding: 40px 48px 180px;
  }

  .ending-eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;

    margin-bottom: 28px;

    color: #ff2638;

    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.18em;
  }

  .ending-eyebrow i {
    display: block;

    width: 70px;
    height: 1px;

    background: #ff2638;
  }

  .timeline-ending h2 {
    margin: 0;

    font-size: clamp(58px, 7vw, 108px);
    line-height: 0.88;
    font-weight: 900;
    letter-spacing: -0.065em;
  }

  .timeline-ending h2 span {
    color: #ff2638;
  }

  .timeline-ending p {
    max-width: 600px;

    margin-top: 38px;

    color: #85807d;

    font-size: 17px;
    line-height: 1.7;
  }


  /* =========================================================
     TABLET
  ========================================================= */

  @media (max-width: 900px) {

    .platform-hero {
      padding: 80px 30px 100px;
    }

    .timeline {
      padding: 20px 30px 100px;
    }

    .timeline-line {
      left: 30px;
    }

    .timeline-item {
      display: block;

      min-height: auto;

      padding-left: 65px;

      margin-bottom: 70px;
    }

    .timeline-marker {
      left: 30px;

      width: 48px;
      height: 48px;
    }

    .timeline-marker span {
      display: none;
    }

    .timeline-item.left .platform-card,
    .timeline-item.right .platform-card {
      margin: 0;
    }

    .timeline-year,
    .timeline-item.left .timeline-year,
    .timeline-item.right .timeline-year {
      position: relative;

      top: auto;
      right: auto;
      left: auto;

      margin-bottom: 12px;
    }

    .platform-card {
      min-height: auto;
    }

    .timeline-ending {
      padding: 30px 30px 120px;
    }

    .hero-stats {
      gap: 45px;
    }

  }


  /* =========================================================
     MOBILE
  ========================================================= */

  @media (max-width: 600px) {

    .platform-hero {
      padding: 60px 22px 80px;
    }

    .hero-eyebrow {
      font-size: 9px;
    }

    .platform-hero h1 {
      font-size: clamp(58px, 17vw, 90px);
    }

    .hero-description {
      margin-top: 32px;

      font-size: 16px;
      line-height: 1.65;
    }

    .hero-stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);

      gap: 20px;

      margin-top: 50px;
    }

    .stat strong {
      font-size: 32px;
    }

    .stat span {
      font-size: 8px;
      letter-spacing: 0.1em;
    }

    .timeline {
      padding: 10px 18px 80px;
    }

    .timeline-line {
      left: 22px;
    }

    .timeline-item {
      padding-left: 48px;

      margin-bottom: 55px;
    }

    .timeline-marker {
      left: 22px;

      width: 40px;
      height: 40px;

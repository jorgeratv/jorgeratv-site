      "Red Dead Redemption 2",
      "Grand Theft Auto V",
      "The Last of Us Part II",
      "God of War",
      "Resident Evil 7",
      "Mortal Kombat X",
      "The Witcher 3",
      "Uncharted 4",
      "Ace Combat 7"
    ]
  },

  {
    year: "2020",
    title: "XBOX SERIES S",
    type: "Nova geração",
    description:
      "Uma entrada na geração atual com uma máquina compacta e capaz de entregar experiências modernas em alta qualidade.",
    games: [
      "Gears 5",
      "DOOM Eternal",
      "Halo Infinite",
      "Forza Horizon 5",
      "Far Cry 5"
    ]
  },

  {
    year: "2022",
    title: "PC DELL G15",
    type: "Meu PC gamer atual",
    description:
      "Uma nova fase no PC gamer. O Dell G15 passou a fazer parte da minha rotina e também se tornou uma peça importante na minha produção de conteúdo.",
    games: [
      "Battlefield 2042",
      "DOOM: The Dark Ages",
      "Counter-Strike 2",
      "Cyberpunk 2077"
    ]
  },

  {
    year: "2023",
    title: "PLAYSTATION 5 SLIM",
    type: "Geração atual",
    description:
      "A geração atual trouxe uma combinação de velocidade, gráficos e grandes experiências. É aqui que minha jornada gamer continua hoje.",
    games: [
      "God of War Ragnarök",
      "Resident Evil 4 Remake",
      "Battlefield 6",
      "Metal Gear Solid Delta",
      "The Callisto Protocol"
    ]
  },

  {
    year: "2024",
    title: "NINTENDO SWITCH LITE",
    type: "Uma nova forma de jogar",
    description:
      "Uma experiência diferente dentro da minha jornada, trazendo a praticidade do portátil e o universo criativo da Nintendo.",
    games: [
      "Super Mario 3D World + Bowser's Fury",
      "Super Mario Odyssey",
      "Mario Kart 8 Deluxe",
      "Donkey Kong Country: Tropical Freeze",
      "The Legend of Zelda: Tears of the Kingdom"
    ]
  }
];
---

<section class="platform-timeline" id="plataformas">

  <div class="platform-timeline-container">

    <!-- CABEÇALHO -->
    <header class="timeline-header">

      <span class="timeline-eyebrow">
        JORGERATV • MINHA HISTÓRIA GAMER
      </span>

      <h1>
        MINHA JORNADA<br />
        <span>PELOS VIDEOGAMES.</span>
      </h1>

      <p class="timeline-intro">
        De um Atari 2600 ao PlayStation 5 e ao PC gamer.
        Mais de três décadas atravessando gerações,
        tecnologias, amizades e histórias que ficaram para sempre.
      </p>

      <div class="timeline-stats">

        <div class="timeline-stat">
          <strong>21</strong>
          <span>Plataformas</span>
        </div>

        <div class="timeline-stat">
          <strong>1990</strong>
          <span>Primeiro contato</span>
        </div>

        <div class="timeline-stat">
          <strong>2024</strong>
          <span>Fase atual</span>
        </div>

      </div>

    </header>


    <!-- INTRODUÇÃO -->
    <div class="journey-intro">

      <span class="journey-label">
        UMA JORNADA
      </span>

      <h2>
        Cada plataforma conta
        uma parte da história.
      </h2>

      <p>
        Alguns eu tive. Outros pertenciam a amigos, primos,
        meu pai ou às locadoras que fizeram parte daquela época.
        Mas todos eles contribuíram de alguma forma para
        construir a minha relação com os videogames.
      </p>

    </div>


    <!-- LINHA DO TEMPO -->
    <div class="timeline">

      {platforms.map((platform, index) => (

        <article
          class:list={[
            "timeline-item",
            index % 2 === 0 ? "timeline-left" : "timeline-right"
          ]}
        >

          <!-- MARCADOR -->
          <div class="timeline-marker">
            <span>{String(index + 1).padStart(2, "0")}</span>
          </div>


          <!-- CONTEÚDO -->
          <div class="timeline-card">

            <div class="timeline-card-top">

              <span class="timeline-year">
                {platform.year}
              </span>

              <span class="timeline-type">
                {platform.type}
              </span>

            </div>


            <h3>
              {platform.title}
            </h3>


            {platform.contact && (
              <p class="timeline-contact">
                {platform.contact}
              </p>
            )}


            <p class="timeline-description">
              {platform.description}
            </p>


            <div class="games-section">

              <span class="games-label">
                JOGOS QUE MARCARAM ESSA FASE
              </span>

              <div class="games-list">

                {platform.games.map((game) => (
                  <span class="game-tag">
                    {game}
                  </span>
                ))}

              </div>

            </div>

          </div>

        </article>

      ))}

    </div>


    <!-- ENCERRAMENTO -->
    <div class="timeline-ending">

      <span>
        E A HISTÓRIA CONTINUA...
      </span>

      <h2>
        Ainda existem muitos
        capítulos pela frente.
      </h2>

      <p>
        Novos jogos, novas plataformas, novas histórias.
        A jornada continua.
      </p>

    </div>

  </div>

</section>

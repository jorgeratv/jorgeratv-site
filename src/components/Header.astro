        Sobre
      </a>


      <!-- SEÇÃO SETUP DA HOME -->
      <a href="/#setup">
        Setup
      </a>


      <!-- SEÇÃO PLATAFORMAS DA HOME -->
      <a href="/#plataformas">
        Plataformas
      </a>


      <!-- YOUTUBE -->
      <a
        href="https://youtube.com/@JorgeraTV"
        target="_blank"
        rel="noopener noreferrer"

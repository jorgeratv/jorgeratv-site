---
import "../styles/platforms.css";
---

<section class="platforms" id="plataformas">

    <div class="container">

        <span class="section-title">
            ONDE ME ENCONTRAR
        </span>

        <h2>
            Acompanhe a JorgeraTV em todas as plataformas
        </h2>

        <p class="platform-description">
            Escolha sua plataforma favorita e venha fazer parte da comunidade.
            Lives, vídeos, bastidores, novidades e muito conteúdo gamer.
        </p>

        <div class="platform-grid">

            <!-- YouTube -->

            <a
                href="https://youtube.com/@JorgeraTV"
                target="_blank"
                rel="noopener noreferrer"
                class="platform-card youtube">

                <div class="icon">▶</div>

                <h3>YouTube</h3>

                <p>
                    Lives, gameplays, reviews e vídeos completos.
                </p>

                <span class="button">
                    Acessar Canal
                </span>

            </a>

            <!-- Twitch -->

            <a
                href="#"
                class="platform-card twitch">

                <div class="icon">🎮</div>

                <h3>Twitch</h3>

                <p>
                    Em breve transmissões simultâneas.
                </p>

                <span class="button">
                    Em Breve
                </span>

            </a>

            <!-- TikTok -->

            <a
                href="#"
                class="platform-card tiktok">

                <div class="icon">🎵</div>

                <h3>TikTok</h3>

                <p>
                    Cortes, momentos engraçados e vídeos curtos.
                </p>

                <span class="button">
                    Em Breve
                </span>

            </a>

            <!-- Instagram -->

            <a
                href="#"
                class="platform-card instagram">

                <div class="icon">📸</div>

                <h3>Instagram</h3>

                <p>
                    Bastidores, fotos e novidades do canal.
                </p>

                <span class="button">
                    Em Breve
                </span>

            </a>

            <!-- Discord -->

            <a
                href="#"
                class="platform-card discord">

                <div class="icon">💬</div>

                <h3>Discord</h3>

                <p>
                    Entre na comunidade e converse durante as lives.
                </p>

                <span class="button">
                    Entrar
                </span>

            </a>

            <!-- Linktree -->

            <a
                href="https://linktr.ee/jorgeratv"
                target="_blank"
                rel="noopener noreferrer"
                class="platform-card linktree">

                <div class="icon">🌐</div>

                <h3>Linktree</h3>

                <p>
                    Todos os links oficiais da JorgeraTV.
                </p>

                <span class="button">
                    Abrir
                </span>

            </a>

            <!-- LivePix -->

            <a
                href="https://livepix.gg/jorgeratv"
                target="_blank"
                rel="noopener noreferrer"
                class="platform-card livepix">

                <div class="icon">❤️</div>

                <h3>LivePix</h3>

                <p>
                    Apoie o canal durante as lives.
                </p>

                <span class="button">
                    Apoiar
                </span>

            </a>

            <!-- Site -->

            <a
                href="/"
                class="platform-card website">

                <div class="icon">🚀</div>

                <h3>Site Oficial</h3>

                <p>
                    Notícias, setup, blog e tudo sobre a JorgeraTV.
                </p>

                <span class="button">
                    Você está aqui
                </span>

            </a>

        </div>

    </div>

</section>
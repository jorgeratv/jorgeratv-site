---

<section class="platforms" id="plataformas">

    <div class="container">

        <!-- CABEÇALHO -->

        <div class="platforms-intro">

            <span class="section-title">
                JORGERATV • MINHA HISTÓRIA GAMER
            </span>

            <h1>
                MINHA JORNADA<br />
                PELOS VIDEOGAMES.
            </h1>

            <p class="intro-text">
                De um Atari 2600 ao PlayStation 5 e ao PC gamer.
                Mais de três décadas atravessando gerações,
                tecnologias, amizades e histórias que ficaram para sempre.
            </p>

            <div class="intro-stats">

                <div>
                    <strong>21</strong>
                    <span>Plataformas</span>
                </div>

                <div>
                    <strong>1990</strong>
                    <span>Primeiro contato</span>
                </div>

                <div>
                    <strong>2024</strong>
                    <span>Fase atual</span>
                </div>

            </div>

        </div>


        <!-- INTRODUÇÃO -->

        <div class="platforms-story">

            <div class="story-label">
                UMA HISTÓRIA EM GERAÇÕES
            </div>

            <h2>
                Cada plataforma conta
                <span>uma parte da história.</span>
            </h2>

            <p>
                Alguns eu tive. Outros pertenciam a amigos, primos,
                meu pai ou às locadoras que fizeram parte daquela época.
                Mas todos eles contribuíram de alguma forma para construir
                a minha relação com os videogames.
            </p>

        </div>


        <!-- ERAS -->

        <div class="platform-eras">

            {eras.map((era) => (

                <section class="platform-era">

                    <div class="era-heading">

                        <div class="era-number">
                            {era.number}
                        </div>

                        <div>

                            <span class="era-label">
                                {era.label}
                            </span>

                            <h2>
                                {era.title}
                            </h2>

                            <p>
                                {era.description}
                            </p>

                        </div>

                    </div>


                    <div class="platform-cards">

                        {era.platforms.map((platform) => (

                            <article class="history-card">

                                <div class="history-card-top">

                                    <span class="platform-year">
                                        {platform.year}
                                    </span>

                                    <span class="platform-type">
                                        {platform.type}
                                    </span>

                                </div>


                                <h3>
                                    {platform.name}
                                </h3>


                                <p class="platform-text">
                                    {platform.description}
                                </p>


                                <div class="games">

                                    <span class="games-label">
                                        JOGOS QUE MARCARAM ESSA FASE
                                    </span>

                                    <ul>

                                        {platform.games.map((game) => (

                                            <li>
                                                {game}
                                            </li>

                                        ))}

                                    </ul>

                                </div>

                            </article>

                        ))}

                    </div>

                </section>

            ))}

        </div>

    </div>

</section>

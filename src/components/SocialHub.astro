---
import "../styles/social-hub.css";
---

<section class="social-hub" id="redes">

    <div class="social-container">

        <!-- =======================================
             CABEÇALHO
        ======================================== -->

        <div class="section-header">

            <span class="section-badge">
                🌐 JORGERATV NAS REDES
            </span>

            <h2>
                Encontre o JorgeraTV
            </h2>

            <p>
                Gameplays, lives, aventuras e bate-papo.
                Escolha sua plataforma e venha fazer parte
                da comunidade.
            </p>

        </div>


        <!-- =======================================
             PRÓXIMA LIVE
        ======================================== -->

        <div class="next-live-card">

            <div class="live-info">

                <span class="live-label">
                    📅 PRÓXIMA LIVE
                </span>

                <h3>
                    Battlefield 6
                </h3>

                <p>
                    Prepare-se para mais uma sessão de gameplay
                    e muita resenha ao vivo.
                </p>

                <div class="live-date">

                    <span>
                        🗓️ Em breve
                    </span>

                    <span>
                        ⏰ Horário a definir
                    </span>

                </div>

            </div>


            <a
                href="https://youtube.com/@JorgeraTV"
                target="_blank"
                rel="noopener noreferrer"
                class="live-button"
            >
                🔔 Acompanhar
            </a>

        </div>


        <!-- =======================================
             REDES SOCIAIS
        ======================================== -->

        <div class="social-grid">


            <!-- ===================================
                 YOUTUBE
            ==================================== -->

            <a
                href="https://youtube.com/@JorgeraTV"
                target="_blank"
                rel="noopener noreferrer"
                class="social-card youtube"
            >

                <span class="social-icon">
                    ▶
                </span>

                <span class="social-text">

                    <strong>
                        YouTube
                    </strong>

                    <small>
                        Gameplays e lives
                    </small>

                </span>

                <span class="arrow">
                    →
                </span>

            </a>


            <!-- ===================================
                 TIKTOK
            ==================================== -->

            <a
                href="https://www.tiktok.com/@jorgeratv"
                target="_blank"
                rel="noopener noreferrer"
                class="social-card tiktok"
            >

                <span class="social-icon">
                    ♪
                </span>

                <span class="social-text">

                    <strong>
                        TikTok
                    </strong>

                    <small>
                        Clipes e momentos
                    </small>

                </span>

                <span class="arrow">
                    →
                </span>

            </a>


            <!-- ===================================
                 INSTAGRAM
            ==================================== -->

            <a
                href="https://www.instagram.com/jorgeratv"
                target="_blank"
                rel="noopener noreferrer"
                class="social-card instagram"
            >

                <span class="social-icon">
                    ◎
                </span>

                <span class="social-text">

                    <strong>
                        Instagram
                    </strong>

                    <small>
                        Bastidores e novidades
                    </small>

                </span>

                <span class="arrow">
                    →
                </span>

            </a>


            <!-- ===================================
                 TWITCH
            ==================================== -->

            <a
                href="https://www.twitch.tv/jorgeratv"
                target="_blank"
                rel="noopener noreferrer"
                class="social-card twitch"
            >

                <span class="social-icon">
                    ◈
                </span>

                <span class="social-text">

                    <strong>
                        Twitch
                    </strong>

                    <small>
                        Lives e gameplay
                    </small>

                </span>

                <span class="arrow">
                    →
                </span>

            </a>


            <!-- ===================================
                 X
            ==================================== -->

            <a
                href="https://x.com/jorgeratv"
                target="_blank"
                rel="noopener noreferrer"
                class="social-card x"
            >

                <span class="social-icon">
                    𝕏
                </span>

                <span class="social-text">

                    <strong>
                        X
                    </strong>

                    <small>
                        Novidades e conversa
                    </small>

                </span>

                <span class="arrow">
                    →
                </span>

            </a>


            <!-- ===================================
                 FACEBOOK
            ==================================== -->

            <a
                href="https://www.facebook.com/jorgeratv"
                target="_blank"
                rel="noopener noreferrer"
                class="social-card facebook"
            >

                <span class="social-icon">
                    f
                </span>

                <span class="social-text">

                    <strong>
                        Facebook
                    </strong>

                    <small>
                        Comunidade JorgeraTV
                    </small>

                </span>

                <span class="arrow">
                    →
                </span>

            </a>


            <!-- ===================================
                 DISCORD
            ==================================== -->

            <a
                href="https://discord.gg/sQRydmDp7z"
                target="_blank"
                rel="noopener noreferrer"
                class="social-card discord"
            >

                <span class="social-icon">
                    ◉
                </span>

                <span class="social-text">

                    <strong>
                        Discord
                    </strong>

                    <small>
                        Entre para a comunidade
                    </small>

                </span>

                <span class="arrow">
                    →
                </span>

            </a>


            <!-- ===================================
                 LINKTREE
            ==================================== -->

            <a
                href="https://linktr.ee/jorgeratv"
                target="_blank"
                rel="noopener noreferrer"
                class="social-card linktree"
            >

                <span class="social-icon">
                    🔗
                </span>

                <span class="social-text">

                    <strong>
                        Linktree
                    </strong>

                    <small>
                        Todos os meus links
                    </small>

                </span>

                <span class="arrow">
                    →
                </span>

            </a>


        </div>

    </div>

</section>

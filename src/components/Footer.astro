---
import "../styles/footer.css";
---

<footer class="footer">

    <div class="container">

        <div class="footer-top">

            <!-- MARCA -->
            <div class="footer-brand">

                <img
                    src="/logo.png"
                    alt="Logo JorgeraTV"
                    class="footer-logo"
                />

                <h2>JORGERATV</h2>

                <p>
                    Gameplays, Aventuras e Bate-Papo.
                    <br />
                    Compartilhando a paixão pelos videogames
                    desde a época das lan houses.
                </p>

            </div>


            <!-- LINKS -->
            <div class="footer-links">

                <!-- NAVEGAÇÃO -->
                <div>

                    <h3>Navegação</h3>

                    <a href="#inicio">
                        Início
                    </a>

                    <a href="#sobre">
                        Sobre
                    </a>

                    <a href="#setup">
                        Setup
                    </a>

                    <a href="#plataformas">
                        Plataformas
                    </a>

                </div>


                <!-- REDES SOCIAIS -->
                <div>

                    <h3>Redes</h3>

                    <a
                        href="https://youtube.com/@JorgeraTV"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        YouTube
                    </a>

                    <a
                        href="https://linktr.ee/jorgeratv"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Linktree
                    </a>

                    <a
                        href="https://livepix.gg/jorgeratv"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        LivePix
                    </a>

                </div>


                <!-- CONTATO -->
                <div>

                    <h3>Contato</h3>

                    <a href="mailto:contato@jorgeratv.com.br">
                        contato@jorgeratv.com.br
                    </a>

                </div>

            </div>

        </div>


        <!-- DIVISÓRIA -->
        <div class="footer-divider"></div>


        <!-- RODAPÉ -->
        <div class="footer-bottom">

            <p>
                © 2026 JorgeraTV.
                Todos os direitos reservados.
            </p>

            <p>
                Desenvolvido com ❤️ por Jorgera.
            </p>

        </div>

    </div>

</footer>

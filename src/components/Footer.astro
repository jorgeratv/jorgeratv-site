---
import "../styles/footer.css";
---

<footer class="footer">

    <div class="container">

        <div class="footer-top">

            <!-- =========================================
                 MARCA
            ========================================== -->

            <div class="footer-brand">

                <img
                    src="/logo.png"
                    alt="Logo JorgeraTV"
                    class="footer-logo"
                />

                <h2>JORGERATV</h2>

                <p>
                    Gameplays, Aventuras e Bate-Papo.
                    <br />
                    Compartilhando a paixão pelos videogames
                    desde a época das lan houses.
                </p>

            </div>


            <!-- =========================================
                 LINKS
            ========================================== -->

            <div class="footer-links">


                <!-- =====================================
                     NAVEGAÇÃO
                ====================================== -->

                <div>

                    <h3>Navegação</h3>

                    <a href="/">
                        Início
                    </a>

                    <a href="/sobre">
                        Sobre
                    </a>

                    <a href="/setup">
                        Setup
                    </a>

                    <a href="/plataformas">
                        Plataformas
                    </a>

                    <!-- APOIE → LIVEPIX -->

                    <a
                        href="https://livepix.gg/jorgeratv"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Apoie
                    </a>

                </div>


                <!-- =====================================
                     REDES SOCIAIS
                ====================================== -->

                <div>

                    <h3>Redes</h3>

                    <!-- YouTube -->

                    <a
                        href="https://www.youtube.com/@JorgeraTV"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        YouTube
                    </a>


                    <!-- TikTok -->

                    <a
                        href="https://www.tiktok.com/@jorgeratv"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        TikTok
                    </a>


                    <!-- Instagram -->

                    <a
                        href="https://www.instagram.com/jorgeratv"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Instagram
                    </a>


                    <!-- Twitch -->

                    <a
                        href="https://www.twitch.tv/jorgeratv"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Twitch
                    </a>


                    <!-- X -->

                    <a
                        href="https://x.com/jorgeratv"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        X
                    </a>


                    <!-- Facebook -->

                    <a
                        href="https://www.facebook.com/jorgeratv"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Facebook
                    </a>


                    <!-- Discord -->

                    <a
                        href="https://discord.com/invite/sQRydmDp7z"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Discord
                    </a>

                </div>


                <!-- =====================================
                     CONTATO PROFISSIONAL
                ====================================== -->

                <div class="footer-contact">

                    <h3>Contato profissional</h3>


                    <p class="footer-contact-label">
                        Publicidade · Patrocínios · Parcerias
                        <br />
                        Lives · Colabs · Projetos
                    </p>


                    <a
                        href="mailto:contato@jorgeratv.com.br"
                        class="footer-contact-email"
                    >
                        contato@jorgeratv.com.br
                    </a>


                    <p class="footer-contact-description">
                        Criadores, marcas e projetos:
                        bora fazer acontecer, porque uma boa ideia
                        pode virar uma grande história.
                    </p>

                </div>

            </div>

        </div>


        <!-- =========================================
             DIVISÓRIA
        ========================================== -->

        <div class="footer-divider"></div>


        <!-- =========================================
             RODAPÉ
        ========================================== -->

        <div class="footer-bottom">

            <p>
                © 2026 JorgeraTV.
                Todos os direitos reservados.
            </p>

            <p>
                Desenvolvido com ❤️ por Jorgera.
            </p>

        </div>

    </div>

</footer>


<style>

    /* =====================================================
       CONTATO PROFISSIONAL
    ====================================================== */

    .footer-contact {
        min-width: 0;
    }


    /* =====================================================
       CATEGORIAS DE CONTATO
    ====================================================== */

    .footer-contact-label {
        margin: 0 0 14px;

        color: #a7a7a7;

        font-size: 14px;

        line-height: 1.65;
    }


    /* =====================================================
       E-MAIL
    ====================================================== */

    .footer-contact-email {
        display: inline-block;

        margin: 2px 0 14px;

        color: #ff343a !important;

        font-size: 17px !important;

        font-weight: 700;

        line-height: 1.4;

        text-decoration: none;

        transition:
            color .25s ease,
            text-shadow .25s ease;
    }


    .footer-contact-email:hover {
        color: #ff555b !important;

        text-shadow:
            0 0 18px rgba(255, 52, 58, .25);
    }


    /* =====================================================
       FRASE FINAL
    ====================================================== */

    .footer-contact-description {
        max-width: 330px;

        margin: 0;

        color: #777;

        font-size: 13px;

        line-height: 1.7;
    }


    /* =====================================================
       DESKTOP
    ====================================================== */

    @media (min-width: 701px) {

        .footer-contact-label {
            white-space: nowrap;
        }

    }


    /* =====================================================
       MOBILE
    ====================================================== */

    @media (max-width: 700px) {

        .footer-contact-label {
            white-space: normal;
        }


        .footer-contact-email {
            font-size: 16px !important;

            overflow-wrap: anywhere;
        }


        .footer-contact-description {
            max-width: 100%;
        }

    }

</style>

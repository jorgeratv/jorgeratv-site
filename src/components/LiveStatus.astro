---
const channelId = "UCAQB_-ospgUM8ZqpvXIz0Nw";
---

<section class="live-status" aria-label="Status da transmissão ao vivo">

    <div class="live-status-card">

        <div class="live-status-icon">
            <span></span>
        </div>

        <div class="live-status-content">

            <div class="live-status-label" id="live-label">
                VERIFICANDO...
            </div>

            <h2 id="live-title">
                JorgeraTV
            </h2>

            <p id="live-message">
                Verificando o status da próxima live...
            </p>

        </div>

        <a
            id="live-button"
            href="https://www.youtube.com/@JorgeraTV"
            target="_blank"
            rel="noopener noreferrer"
            class="live-status-button"
        >
            YouTube
        </a>

    </div>

</section>

<style>

    .live-status {
        width: 100%;
        padding: 0 20px 40px;
    }

    .live-status-card {
        max-width: 1100px;
        margin: 0 auto;

        display: flex;
        align-items: center;
        gap: 20px;

        padding: 22px 26px;

        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 16px;

        background:
            linear-gradient(
                135deg,
                rgba(255,255,255,0.055),
                rgba(255,255,255,0.018)
            );

        box-shadow:
            0 12px 40px rgba(0,0,0,0.25);

        backdrop-filter: blur(12px);
    }

    .live-status-icon {
        width: 18px;
        height: 18px;

        flex-shrink: 0;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;
        background: rgba(120,120,120,0.18);
    }

    .live-status-icon span {
        width: 8px;
        height: 8px;

        border-radius: 50%;

        background: #777;
    }

    .live-status-content {
        flex: 1;
        min-width: 0;
    }

    .live-status-label {
        margin-bottom: 4px;

        font-size: 12px;
        font-weight: 800;

        letter-spacing: 0.14em;

        color: #aaa;
    }

    .live-status-content h2 {
        margin: 0;

        font-size: 20px;
        font-weight: 800;

        color: #fff;
    }

    .live-status-content p {
        margin: 4px 0 0;

        font-size: 14px;

        color: #aaa;
    }

    .live-status-button {
        flex-shrink: 0;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        padding: 10px 18px;

        border-radius: 9px;

        background: #d61f26;
        color: #fff;

        text-decoration: none;

        font-size: 13px;
        font-weight: 800;

        transition:
            transform 0.2s ease,
            opacity 0.2s ease;
    }

    .live-status-button:hover {
        transform: translateY(-2px);
        opacity: 0.9;
    }

    /* =========================
       ESTADO AO VIVO
    ========================== */

    .live-status.is-live .live-status-icon {
        background: rgba(214,31,38,0.18);
    }

    .live-status.is-live .live-status-icon span {
        background: #ff2d35;

        box-shadow:
            0 0 0 5px rgba(255,45,53,0.08),
            0 0 18px rgba(255,45,53,0.75);

        animation: livePulse 1.5s infinite;
    }

    .live-status.is-live .live-status-label {
        color: #ff3b43;
    }

    .live-status.is-live .live-status-button {
        background: #d61f26;
    }

    /* =========================
       ESTADO OFFLINE
    ========================== */

    .live-status.is-offline .live-status-button {
        background: rgba(255,255,255,0.08);
    }

    @keyframes livePulse {

        0% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.25);
            opacity: 0.65;
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }

    }

    @media (max-width: 650px) {

        .live-status-card {
            padding: 18px;
            gap: 14px;
        }

        .live-status-button {
            padding: 9px 12px;
            font-size: 12px;
        }

        .live-status-content h2 {
            font-size: 17px;
        }

        .live-status-content p {
            font-size: 12px;
        }

    }

</style>

<script>

    const root = document.querySelector(".live-status");
    const label = document.querySelector("#live-label");
    const title = document.querySelector("#live-title");
    const message = document.querySelector("#live-message");
    const button = document.querySelector("#live-button");

    async function verificarLive() {

        try {

            /*
             * O arquivo live.json será gerado posteriormente
             * pelo nosso processo seguro no GitHub Actions.
             *
             * A chave da API do YouTube NÃO ficará neste arquivo.
             */

            const response = await fetch("/live.json", {
                cache: "no-store"
            });

            if (!response.ok) {
                throw new Error("live.json não encontrado");
            }

            const data = await response.json();

            root?.classList.remove("is-live");
            root?.classList.remove("is-offline");

            if (data.live === true) {

                root?.classList.add("is-live");

                label.textContent = "🔴 AO VIVO AGORA";

                title.textContent =
                    data.title || "JorgeraTV está ao vivo";

                message.textContent =
                    "A transmissão está acontecendo agora!";

                button.textContent =
                    "ASSISTIR AO VIVO";

                button.href =
                    data.url ||
                    "https://www.youtube.com/@JorgeraTV/live";

            } else {

                root?.classList.add("is-offline");

                label.textContent =
                    "⚫ OFFLINE";

                title.textContent =
                    data.title ||
                    "JorgeraTV";

                message.textContent =
                    data.message ||
                    "Nenhuma transmissão ao vivo no momento.";

                button.textContent =
                    "VER NO YOUTUBE";

                button.href =
                    "https://www.youtube.com/@JorgeraTV";

            }

        } catch (error) {

            root?.classList.remove("is-live");
            root?.classList.add("is-offline");

            label.textContent =
                "⚫ OFFLINE";

            title.textContent =
                "JorgeraTV";

            message.textContent =
                "Confira as próximas transmissões no YouTube.";

            button.textContent =
                "ABRIR YOUTUBE";

            button.href =
                "https://www.youtube.com/@JorgeraTV";

        }

    }

    verificarLive();

    /*
     * Atualiza automaticamente a cada 60 segundos.
     */

    setInterval(verificarLive, 60000);

</script>

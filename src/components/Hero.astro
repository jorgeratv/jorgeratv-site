---
import "../styles/hero.css";
---

<section class="hero" id="inicio">

  <div class="background-glow"></div>

  <div class="hero-content fade-up">

    <img
      src="/logo.png"
      alt="Logo JorgeraTV"
      class="logo float"
    />

    <span class="badge">
      🎮 Canal Oficial JorgeraTV
    </span>

    <h1>
      Seu próximo lugar favorito na internet.
    </h1>

    <p>
      Chega mais. A gente joga, conversa e dá risada.
    </p>

  </div>

</section>

<style>
  /*
   * Hero compacto:
   * mantém o logo e a identidade visual,
   * sem reservar espaço desnecessário.
   */

  .hero {
    min-height: auto !important;
    padding: 140px 20px 35px !important;
  }

  .hero h1 {
    margin-bottom: 12px;
  }

  .hero p {
    margin-top: 0;
  }
</style>

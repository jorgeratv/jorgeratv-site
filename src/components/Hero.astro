---
import "../styles/hero.css";
---

<section class="hero" id="inicio">

  <div class="background-glow"></div>

  <div class="hero-content fade-up">

    <img
      src="/logo.png"
      alt="Logo JorgeraTV"
      class="logo float"
    />

    <span class="badge">
      🎮 Canal Oficial JorgeraTV
    </span>

    <h1>
      Gameplays, Aventuras e Bate-Papo
    </h1>

    <p>
      Jogando desde a época das lan houses.
      Hoje compartilhando essa paixão com quem também ama videogames.
    </p>

  </div>

</section>

<style>
  /*
   * Hero compacto:
   * remove a altura mínima de uma tela inteira
   * e elimina o espaço reservado pelos elementos removidos.
   */

  .hero {
    min-height: auto !important;
    padding: 140px 20px 35px !important;
  }
</style>

---
import "../styles/hero.css";
---

<section class="hero" id="inicio">

  <div class="background-glow"></div>

  <div class="hero-content fade-up">

    <img
      src="/logo.png"
      alt="Logo JorgeraTV"
      class="logo float"
    />

    <span class="badge">
      🎮 Canal Oficial JorgeraTV
    </span>

    <h1>
      Gameplays, Aventuras e Bate-Papo
    </h1>

    <p>
      Jogando desde a época das lan houses.
      Hoje compartilhando essa paixão com quem também ama videogames.
    </p>

    <div class="buttons">

      <a
        href="https://youtube.com/@JorgeraTV"
        target="_blank"
        rel="noopener noreferrer"
        class="btn youtube">

        ▶ YouTube

      </a>

      <a
        href="https://livepix.gg/jorgeratv"
        target="_blank"
        rel="noopener noreferrer"
        class="btn support">

        ❤️ Apoie o Canal

      </a>

      <a
        href="https://linktr.ee/jorgeratv"
        target="_blank"
        rel="noopener noreferrer"
        class="btn links">

        🌐 Todas as Redes

      </a>

    </div>

    <div class="stats">

      <div class="card">

        <span class="number">🎮</span>

        <span class="label">
          Battlefield 6
        </span>

      </div>

      <div class="card">

        <span class="number">🔴</span>

        <span class="label">
          Lives Semanais
        </span>

      </div>

      <div class="card">

        <span class="number">💻</span>

        <span class="label">
          Tecnologia
        </span>

      </div>

    </div>

  </div>

  <a href="#sobre" class="scroll">

      ↓

  </a>

</section>
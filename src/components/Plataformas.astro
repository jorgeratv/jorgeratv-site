            <!-- =================================================
                 3DO
            ================================================== -->

            <article
                class="platform-era"
                data-status="arcade"
            >

                <span class="platform-era__marker"></span>
                <span class="platform-era__connector"></span>

                <div class="platform-era__year">
                    1995
                </div>

                <div class="platform-era__status">
                    CONHECI NA LOCADORA
                </div>

                <h2>
                    3DO
                </h2>

                <p class="platform-era__description">
                    Uma experiência diferente para a época.
                    Eu pagava por hora na locadora para poder jogar
                    e conhecer aquele hardware.
                </p>

                <div class="platform-era__card">

                    <div class="platform-era__card-header">
                        <span class="platform-era__type">
                            Locadora
                        </span>

                        <span class="platform-era__count">
                            4 jogos
                        </span>
                    </div>

                    <div class="platform-games">

                        <div class="platform-game">
                            <img src="/assets/road-rash.jpg" alt="Road Rash">
                            <span class="platform-game__name">Road Rash</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/need-for-speed.jpg" alt="The Need for Speed">
                            <span class="platform-game__name">The Need for Speed</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/doom.jpg" alt="Doom">
                            <span class="platform-game__name">Doom</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/super-street-fighter-ii-turbo.jpg" alt="Super Street Fighter II Turbo">
                            <span class="platform-game__name">Super Street Fighter II Turbo</span>
                        </div>

                    </div>

                </div>

            </article>


            <!-- =================================================
                 NEO GEO CD
            ================================================== -->

            <article
                class="platform-era"
                data-status="arcade"
            >

                <span class="platform-era__marker"></span>
                <span class="platform-era__connector"></span>

                <div class="platform-era__year">
                    1995
                </div>

                <div class="platform-era__status">

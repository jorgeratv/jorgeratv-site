---
import "../styles/platform-timeline.css";
---

<section class="platform-timeline">

    <div class="platform-timeline__container">

        <!-- =====================================================
             INTRO
        ====================================================== -->

        <div class="platform-timeline__intro">

            <div class="platform-timeline__eyebrow">
                UMA VIDA ATRAVÉS DOS GAMES
            </div>

            <h1>
                Minha história
                <span>em pixels.</span>
            </h1>

            <p>
                Antes de existir a JorgeraTV, existiu uma criança,
                alguns videogames e uma paixão que nunca mais foi embora.
                Esta é a linha do tempo das máquinas, jogos e momentos
                que fizeram parte da minha jornada gamer.
            </p>

        </div>


        <!-- =====================================================
             TIMELINE
        ====================================================== -->

        <div class="platform-timeline__track">


            <!-- =================================================
                 ATARI
            ================================================== -->

            <article
                class="platform-era"
                data-status="owned"
            >

                <span class="platform-era__marker"></span>

                <span class="platform-era__connector"></span>

                <div class="platform-era__year">
                    1990
                </div>

                <div class="platform-era__status">
                    TIVE
                </div>

                <h2>
                    Atari 2600
                </h2>

                <p class="platform-era__description">
                    O começo de tudo. Foi aqui que nasceu minha paixão
                    pelos videogames e pelas histórias que eles eram
                    capazes de criar.
                </p>

                <div class="platform-era__card">

                    <div class="platform-era__card-header">

                        <span class="platform-era__type">
                            Jogos inesquecíveis
                        </span>

                        <span class="platform-era__count">
                            7 jogos
                        </span>

                    </div>

                    <div class="platform-games">

                        <div class="platform-game">
                            <img src="/assets/pitfall.jpg" alt="Pitfall">
                            <span class="platform-game__name">Pitfall</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/river-raid.jpg" alt="River Raid">
                            <span class="platform-game__name">River Raid</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/enduro.jpg" alt="Enduro">
                            <span class="platform-game__name">Enduro</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/frogger.jpg" alt="Frogger">
                            <span class="platform-game__name">Frogger</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/pac-man.jpg" alt="Pac-Man">
                            <span class="platform-game__name">Pac-Man</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/adventure.jpg" alt="Adventure">
                            <span class="platform-game__name">Adventure</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/hero.jpg" alt="H.E.R.O.">
                            <span class="platform-game__name">H.E.R.O.</span>
                        </div>

                    </div>

                </div>

            </article>


            <!-- =================================================
                 MASTER SYSTEM
            ================================================== -->

            <article
                class="platform-era"
                data-status="friend"
            >

                <span class="platform-era__marker"></span>
                <span class="platform-era__connector"></span>

                <div class="platform-era__year">
                    ERA 90
                </div>

                <div class="platform-era__status">
                    CONHECI COM AMIGOS
                </div>

                <h2>
                    Master System
                </h2>

                <p class="platform-era__description">
                    Eu não tinha um, mas meus amigos tinham.
                    E videogame na infância não precisava ser seu
                    para virar parte da sua memória.
                </p>

                <div class="platform-era__card">

                    <div class="platform-era__card-header">

                        <span class="platform-era__type">
                            Jogos marcantes
                        </span>

                        <span class="platform-era__count">
                            5 jogos
                        </span>

                    </div>

                    <div class="platform-games">

                        <div class="platform-game">
                            <img src="/assets/alex-kidd.jpg" alt="Alex Kidd">
                            <span class="platform-game__name">Alex Kidd</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/sonic.jpg" alt="Sonic">
                            <span class="platform-game__name">Sonic</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/shinobi.jpg" alt="Shinobi">
                            <span class="platform-game__name">Shinobi</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/golden-axe.jpg" alt="Golden Axe">
                            <span class="platform-game__name">Golden Axe</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/double-dragon.jpg" alt="Double Dragon">
                            <span class="platform-game__name">Double Dragon</span>
                        </div>

                    </div>

                </div>

            </article>


            <!-- =================================================
                 NES
            ================================================== -->

            <article
                class="platform-era"
                data-status="owned"
            >

                <span class="platform-era__marker"></span>
                <span class="platform-era__connector"></span>

                <div class="platform-era__year">
                    1993
                </div>

                <div class="platform-era__status">
                    TIVE
                </div>

                <h2>
                    Nintendo NES
                </h2>

                <p class="platform-era__description">
                    Uma das grandes portas de entrada para os clássicos
                    que ajudaram a definir minha infância gamer.
                </p>

                <div class="platform-era__card">

                    <div class="platform-era__card-header">
                        <span class="platform-era__type">
                            Clássicos
                        </span>

                        <span class="platform-era__count">
                            6 jogos
                        </span>
                    </div>

                    <div class="platform-games">

                        <div class="platform-game">
                            <img src="/assets/super-mario-bros.jpg" alt="Super Mario Bros">
                            <span class="platform-game__name">Super Mario Bros.</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/contra.jpg" alt="Contra">
                            <span class="platform-game__name">Contra</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/ducktales.jpg" alt="DuckTales">
                            <span class="platform-game__name">DuckTales</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/mega-man-2.jpg" alt="Mega Man 2">
                            <span class="platform-game__name">Mega Man 2</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/castlevania.jpg" alt="Castlevania">
                            <span class="platform-game__name">Castlevania</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/battletoads.jpg" alt="Battletoads">
                            <span class="platform-game__name">Battletoads</span>
                        </div>

                    </div>

                </div>

            </article>


            <!-- =================================================
                 MEGA DRIVE
            ================================================== -->

            <article
                class="platform-era"
                data-status="friend"
            >

                <span class="platform-era__marker"></span>
                <span class="platform-era__connector"></span>

                <div class="platform-era__year">
                    1993
                </div>

                <div class="platform-era__status">
                    CONHECI COM PRIMOS
                </div>

                <h2>
                    Mega Drive
                </h2>

                <p class="platform-era__description">
                    Outro console que não era meu, mas que entrou
                    na minha história através das partidas com meus primos.
                </p>

                <div class="platform-era__card">

                    <div class="platform-era__card-header">
                        <span class="platform-era__type">
                            Memórias
                        </span>

                        <span class="platform-era__count">
                            4 jogos
                        </span>
                    </div>

                    <div class="platform-games">

                        <div class="platform-game">
                            <img src="/assets/altered-beast.jpg" alt="Altered Beast">
                            <span class="platform-game__name">Altered Beast</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/streets-of-rage.jpg" alt="Streets of Rage">

                            <img src="/assets/prince-of-persia.jpg" alt="Prince of Persia">
                            <span class="platform-game__name">Prince of Persia</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/stunts.jpg" alt="Stunts">
                            <span class="platform-game__name">Stunts</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/monkey-island.jpg" alt="Monkey Island">

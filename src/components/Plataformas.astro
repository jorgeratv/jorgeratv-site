            <!-- =================================================
                 PENTIUM 2
            ================================================== -->

            <article
                class="platform-era"
                data-status="owned"
            >

                <span class="platform-era__marker"></span>
                <span class="platform-era__connector"></span>

                <div class="platform-era__year">
                    1997
                </div>

                <div class="platform-era__status">
                    MEU PRIMEIRO PC
                </div>

                <h2>
                    Pentium II + Windows 95
                </h2>

                <p class="platform-era__description">
                    Meu primeiro computador exclusivamente meu.
                    A partir daqui o PC deixou de ser apenas uma curiosidade
                    e passou a ser parte da minha vida.
                </p>

                <div class="platform-era__card">

                    <div class="platform-era__card-header">
                        <span class="platform-era__type">
                            PC Gaming
                        </span>

                        <span class="platform-era__count">
                            7 jogos
                        </span>

                </p>

                <div class="platform-era__card">

                    <div class="platform-era__card-header">
                        <span class="platform-era__type">
                            A era dourada
                        </span>

                        <span class="platform-era__count">
                            15 jogos
                        </span>
                    </div>

                    <div class="platform-games">

                        <div class="platform-game">
                            <img src="/assets/donkey-kong-country.jpg" alt="Donkey Kong Country">
                            <span class="platform-game__name">Donkey Kong</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/super-mario-world.jpg" alt="Super Mario World">
                            <span class="platform-game__name">Super Mario World</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/mortal-kombat.jpg" alt="Mortal Kombat">
                            <span class="platform-game__name">Mortal Kombat</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/street-fighter-ii.jpg" alt="Street Fighter">

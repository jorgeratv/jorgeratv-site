                        </div>

                        <div class="platform-game">
                            <img src="/assets/contra-iii.jpg" alt="Contra III">
                            <span class="platform-game__name">Contra III</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/top-gear.jpg" alt="Top Gear">

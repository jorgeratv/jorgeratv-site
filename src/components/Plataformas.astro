                        </div>

                        <div class="platform-game">
                            <img src="/assets/metal-slug.jpg" alt="Metal Slug">
                            <span class="platform-game__name">Metal Slug</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/samurai-shodown-iii.jpg" alt="Samurai Shodown III">
                            <span class="platform-game__name">Samurai Shodown III</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/fatal-fury-special.jpg" alt="Fatal Fury Special">
                            <span class="platform-game__name">Fatal Fury Special</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/super-sidekicks-3.jpg" alt="Super Sidekicks 3">
                            <span class="platform-game__name">Super Sidekicks 3</span>
                        </div>

                    </div>

                </div>

            </article>


            <!-- =================================================
                 NINTENDO 64
            ================================================== -->

            <article
                class="platform-era"
                data-status="owned"
            >

                <span class="platform-era__marker"></span>
                <span class="platform-era__connector"></span>

                <div class="platform-era__year">
                    1997
                </div>

                <div class="platform-era__status">
                    TIVE
                </div>

                <h2>
                    Nintendo 64
                </h2>

                <p class="platform-era__description">
                    Uma geração que trouxe 3D, mundos enormes e algumas
                    das experiências mais marcantes da minha adolescência.
                </p>

                <div class="platform-era__card">

                    <div class="platform-era__card-header">

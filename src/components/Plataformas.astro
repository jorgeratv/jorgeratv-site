                        </div>

                        <div class="platform-game">
                            <img src="/assets/demons-crest.jpg" alt="Demon's Crest">
                            <span class="platform-game__name">Demon's Crest</span>
                        </div>

                    </div>

                </div>

            </article>


            <!-- =================================================
                 PC 486
            ================================================== -->

            <article
                class="platform-era"
                data-status="owned"
            >

                <span class="platform-era__marker"></span>
                <span class="platform-era__connector"></span>

                <div class="platform-era__year">
                    1994
                </div>

                <div class="platform-era__status">
                    CONHECI COM MEU PAI
                </div>

                <h2>
                    PC 486 + Windows 3.1
                </h2>

                <p class="platform-era__description">
                    Meu pai tinha o computador, mas deixava eu brincar.
                    Foi aqui que comecei a descobrir que computadores
                    podiam ser muito mais do que ferramentas de trabalho.
                </p>

                <div class="platform-era__card">

                    <div class="platform-era__card-header">
                        <span class="platform-era__type">
                            Primeiros passos no PC
                        </span>

                        <span class="platform-era__count">
                            9 jogos
                        </span>
                    </div>

                    <div class="platform-games">

                        <div class="platform-game">
                            <img src="/assets/doom.jpg" alt="Doom">
                            <span class="platform-game__name">Doom</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/wolfenstein-3d.jpg" alt="Wolfenstein 3D">
                            <span class="platform-game__name">Wolfenstein</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/duke-nukem-3d.jpg" alt="Duke Nukem 3D">
                            <span class="platform-game__name">Duke Nukem 3D</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/hexen.jpg" alt="Hexen">

                        </div>

                        <div class="platform-game">
                            <img src="/assets/iss-deluxe.jpg" alt="International Superstar Soccer Deluxe">
                            <span class="platform-game__name">ISS Deluxe</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/final-fight.jpg" alt="Final Fight">
                            <span class="platform-game__name">Final Fight</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/sunset-riders.jpg" alt="Sunset Riders">
                            <span class="platform-game__name">Sunset Riders</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/aladdin.jpg" alt="Aladdin">
                            <span class="platform-game__name">Aladdin</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/legend-of-mana.jpg" alt="Legend of Mana">

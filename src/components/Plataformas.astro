                        </div>

                        <div class="platform-game">
                            <img src="/assets/star-fox-64.jpg" alt="Star Fox 64">
                            <span class="platform-game__name">Star Fox 64</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/1080-snowboarding.jpg" alt="1080 Snowboarding">
                            <span class="platform-game__name">1080 Snowboarding</span>
                        </div>

                        <div class="platform-game">
                            <img src="/assets/wave-race-64.jpg" alt="Wave Race 64">
                            <span class="platform-game__name">Wave Race 64</span>

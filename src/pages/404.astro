---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="Página não encontrada | JorgeraTV"
    description="A página que você procura não foi encontrada."
>

    <Header />

    <main class="error-page">

        <div class="error-content">

            <span class="error-badge">
                🎮 JORGERATV
            </span>

            <h1>
                Essa página saiu da partida.
            </h1>

            <p>
                Parece que esse endereço não existe.
                Mas a resenha continua por aqui.
            </p>

            <a href="/" class="error-button">
                ← Voltar para a Home
            </a>

        </div>

    </main>

    <Footer />

</Layout>


<style>

    .error-page {
        min-height: 65vh;

        display: flex;
        align-items: center;
        justify-content: center;

        padding: 100px 20px;

        background:
            radial-gradient(
                circle at 50% 30%,
                rgba(120, 0, 0, 0.22),
                transparent 55%
            ),
            #080607;

        text-align: center;
    }


    .error-content {
        width: min(800px, 100%);
    }


    .error-badge {
        display: inline-block;

        padding: 7px 16px;

        border: 1px solid rgba(255, 40, 40, 0.45);

        border-radius: 999px;

        color: #ff3b3b;

        font-size: 12px;
        font-weight: 700;

        letter-spacing: 1px;
    }


    .error-content h1 {
        margin: 22px 0 15px;

        color: #ffffff;

        font-size: clamp(38px, 6vw, 64px);

        line-height: 1.05;

        font-weight: 800;

        letter-spacing: -2px;
    }


    .error-content p {
        margin: 0 auto 30px;

        max-width: 600px;

        color: #bdbdbd;

        font-size: 18px;

        line-height: 1.6;
    }


    .error-button {
        display: inline-block;

        padding: 13px 24px;

        border-radius: 10px;

        background: #d71920;

        color: #ffffff;

        text-decoration: none;

        font-weight: 700;

        transition:
            transform 0.2s ease,
            background 0.2s ease;
    }


    .error-button:hover {
        background: #ef2028;

        transform: translateY(-2px);
    }


    @media (max-width: 600px) {

        .error-page {
            padding: 80px 20px;
        }

        .error-content h1 {
            font-size: 40px;
        }

        .error-content p {
            font-size: 16px;
        }

    }

</style>

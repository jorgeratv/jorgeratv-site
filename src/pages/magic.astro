---
import Layout from "../layouts/Layout.astro";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout
    title="Magic: The Gathering | JorgeraTV"
    description="A história de George com Magic: The Gathering, desde os primeiros anos no Brasil até Magic: The Gathering Arena."
>

    <Header />

    <main>

        <section class="magic-page">

            <div class="magic-intro">

                <span class="magic-kicker">
                    UMA HISTÓRIA ALÉM DAS CARTAS
                </span>

                <h1>
                    MAGIC:
                    <br />
                    THE GATHERING
                </h1>

                <p class="magic-lead">
                    Uma história de amizade, descobertas, cartas,
                    partidas intermináveis e uma paixão que atravessou
                    décadas.
                </p>

            </div>

        </section>

    </main>

    <Footer />

</Layout>

<style>
    .magic-page {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 140px 24px;
        background:
            radial-gradient(
                circle at 50% 30%,
                rgba(180, 0, 0, 0.14),
                transparent 45%
            );
    }

    .magic-intro {
        width: min(1100px, 100%);
        text-align: center;
    }

    .magic-kicker {
        display: inline-block;
        margin-bottom: 24px;
        color: #ff3038;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.22em;
        text-transform: uppercase;
    }

    h1 {
        margin: 0;
        color: #f2eee8;
        font-size: clamp(4rem, 10vw, 9rem);
        line-height: 0.88;
        font-weight: 900;
        letter-spacing: -0.05em;
    }

    .magic-lead {
        max-width: 760px;
        margin: 40px auto 0;
        color: #aaa4a0;
        font-size: clamp(1.1rem, 2vw, 1.4rem);
        line-height: 1.7;
    }
</style>
